CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_ADV360_RIGHT=y

# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable SPI for LEDS
CONFIG_PINCTRL=y
CONFIG_SPI=y
CONFIG_SPI_NRFX=y

# Enable writing to flash
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Enable 32kHz crystal
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_150PPM=y

#RGB leds config
CONFIG_WS2812_STRIP=y
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=y
# Idle auto-off is set to y for both halves in config/adv360.conf, which is
# applied after this file. Nothing here needs to differ between the sides.

#Backlighting configuration
CONFIG_PWM=y
CONFIG_LED_PWM=y
CONFIG_ZMK_BACKLIGHT=y

#Misc configuration
CONFIG_USB_DEVICE_VID=0x29EA
CONFIG_USB_DEVICE_PID=0x0362
CONFIG_USB_DEVICE_MANUFACTURER="Kinesis Corporation"
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_BUILD_OUTPUT_UF2=y

# EXPERIMENTAL_FEATURES pulls in EXPERIMENTAL_SEC, which turns on passkey
# entry. This half is the peripheral and never pairs with a host, so it is
# inert here, but it is pinned off to match the left half rather than leaving
# the two sides silently different.
CONFIG_ZMK_BLE_EXPERIMENTAL_FEATURES=y
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# Removed 2026-08-22: these are owned by config/adv360.conf. Declaring
# them here too made the consumer usage range depend on fragment
# ordering - the defconfigs said BASIC=y while adv360.conf says FULL=y,
# and under BASIC the SYS calculator/files/search/lock keys are
# silently unsendable. bin/validate_keymap.py now fails on any overlap.
