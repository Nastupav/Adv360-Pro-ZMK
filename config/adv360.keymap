/*
 * Kinesis Advantage360 Pro / ZMK keymap
 * Production ergonomic developer layout — macOS-primary, Linux/Windows secondary.
 *
 * Layer order:
 *   0 BASE
 *   1 NAV
 *   2 SYM
 *   3 NUM
 *   4 FUN
 *   5 SYS
 *   6 APP
 *
 * Efficiency updates applied:
 *   - Tuned positional HRMs with shorter tap terms and modern upstream
 *     misfire protection (`require-prior-idle-ms`, `hold-trigger-on-release`).
 *     If your Kinesis fork does not support those two properties, remove them
 *     from hml/hmr only.
 *   - Split thumb layer-taps by job: NAV/FUN, delete-style keys, and APP/ESC.
 *   - Replaced duplicate base thumb ESC/TAB with `&key_repeat` and sticky GUI.
 *   - SYS is activated conditionally by holding NAV + SYM together.
 *   - Added coding pair macros for (), [], {}, and "".
 *
 * Matrix layout (per layer, 76 keys total):
 *   row1  6 + 1L-thumb-row + 1R-thumb-row + 6     = 14   pos  0..13
 *   row2  6 + 1 inner       + 1 inner        + 6  = 14   pos 14..27
 *   row3  6 + 3 thumb cluster + 3 thumb cluster + 6 = 18  pos 28..45
 *   row4  6 + 1L-thumb       + 1R-thumb       + 6 = 14   pos 46..59
 *   row5  5 + 3L-thumbs      + 3R-thumbs      + 5 = 16   pos 60..75
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define SYS  5
#define APP  6

/ {
    behaviors {
        /*
         * Positional home-row mods.
         *
         * These only trigger as holds when paired with the opposite hand.
         * `require-prior-idle-ms` and `hold-trigger-on-release` are upstream ZMK
         * HRM improvements. If your Kinesis fork errors on either property,
         * delete just those two lines from hml/hmr.
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                8 9 10 11 12 13
                22 23 24 25 26 27
                37 38 39 40 41 42 43 44 45
                53 54 55 56 57 58 59
                68 69 70 71 72 73 74 75
            >;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5 6
                14 15 16 17 18 19 20
                28 29 30 31 32 33 34 35 36
                46 47 48 49 50 51 52
                60 61 62 63 64 65 66 67
            >;
        };

        /*
         * Split thumb layer-taps.
         * NAV/FUN are tuned for low-latency Space/Enter.
         * Delete-style keys get a longer quick-tap window for repeat/delete use.
         * APP/ESC is tuned fastest to keep Escape snappy.
         */
        tlt_nav: thumb_layer_tap_nav {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP_NAV";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        tlt_del: thumb_layer_tap_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP_DELETE";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <190>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };

        tlt_app: thumb_layer_tap_app {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP_APP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <160>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        /*
         * Sticky GUI for one-shot Cmd shortcuts on macOS.
         * Example: tap sticky GUI, then tap C/V/F/S/etc.
         */
        skq: sticky_key_quick {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_QUICK";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1200>;
            quick-release;
            ignore-modifiers;
        };
    };

    macros {
        compatible = "zmk,macros";

        parens_pair: parens_pair {
            compatible = "zmk,behavior-macro";
            label = "PARENS_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LPAR &kp RPAR &kp LEFT>;
        };

        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            label = "BRACKET_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LBKT &kp RBKT &kp LEFT>;
        };

        brace_pair: brace_pair {
            compatible = "zmk,behavior-macro";
            label = "BRACE_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LBRC &kp RBRC &kp LEFT>;
        };

        quote_pair: quote_pair {
            compatible = "zmk,behavior-macro";
            label = "QUOTE_PAIR";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp DQT &kp DQT &kp LEFT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_from_nav_sym {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Clear ONLY the currently selected Bluetooth profile.
         * Gated to SYS layer; both BT_SEL 0 + BT_SEL 1 positions must be pressed
         * together. Will not trigger on any other layer.
         */
        combo_bt_clear {
            timeout-ms = <120>;
            key-positions = <1 2>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };

        /*
         * Enter bootloader only from SYS, and only by pressing the two inner
         * row-2 keys together.
         */
        combo_bootloader {
            timeout-ms = <200>;
            key-positions = <20 21>;
            layers = <SYS>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0: BASE
        // SYS is no longer directly bound. Hold NAV + SYM together to activate
        // SYS through the conditional layer.
        // =========================================================

        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5     &none                                                                              &none             &kp N6    &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T      &none                                                                              &none             &kp Y     &kp U        &kp I        &kp O        &kp P        &kp BSLH
&kp ESC    &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G      &kp LGUI       &kp LCTRL     &kp LALT        &kp RALT   &kp RCTRL  &kp RGUI      &kp H     &hmr RSHFT J &hmr RCTRL K &hmr RALT L  &hmr RGUI SEMI &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B                                      &tlt_app APP ESC  &kp TAB                                               &kp N     &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
&kp GRAVE  &kp LBKT    &kp RBKT    &kp LPAR     &kp RPAR                 &tlt_del SYM BSPC   &tlt_del NUM DEL  &key_repeat    &skq LGUI    &tlt_nav FUN ENTER &tlt_nav NAV SPACE                    &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &none
            >;
        };

        // =========================================================
        // LAYER 1: NAV  (hold right-thumb Space)
        // macOS-tuned. Arrows on J/K/L/;.
        // =========================================================

        layer_nav {
            display-name = "NAV";
            bindings = <
&kp ESC    &kp LA(LEFT)       &kp LA(RIGHT)       &kp LG(LBKT)       &kp LG(RBKT)        &kp PSCRN        &none                                                                         &none       &kp LC(LS(TAB)) &kp LC(TAB)    &kp LG(TAB)      &kp LG(LS(TAB)) &kp PG_UP      &kp PG_DN
&kp TAB    &kp LG(Z)          &kp LG(LS(Z))       &kp LG(X)          &kp LG(C)           &kp LG(V)        &none                                                                         &none       &kp HOME        &kp PG_DN      &kp PG_UP        &kp END         &kp DEL        &kp BSPC
&kp ESC    &kp LC(A)          &kp LC(E)           &kp LC(U)          &kp LC(K)           &kp LC(W)        &kp LGUI       &kp LCTRL      &kp LALT        &kp RALT     &kp RCTRL    &kp RGUI       &kp HOME  &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT      &kp ENTER
&kp LSHFT  &kp LG(S)          &kp LG(F)           &kp LC(R)          &kp LC(C)           &kp LC(D)                                        &trans           &trans                                              &kp LA(LEFT) &kp LA(RIGHT) &kp LA(LS(LEFT)) &kp LA(LS(RIGHT)) &kp LA(BSPC) &kp RSHFT
&kp ESC    &kp TAB            &kp LG(Z)           &kp LG(LS(Z))      &kp LC(L)                           &kp BSPC       &kp DEL       &kp LSHFT       &kp LCTRL     &kp ENTER      &trans                            &kp HOME  &kp END       &kp PG_UP    &kp PG_DN     &trans
            >;
        };

        // =========================================================
        // LAYER 2: SYM  (hold left-thumb Backspace)
        // Opening delimiters on left, closing delimiters on right.
        // Bottom row includes pair macros for coding.
        // =========================================================

        layer_sym {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &none                                                                          &none       &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR   &kp TILDE
&kp TAB    &kp TILDE &kp GRAVE &kp BSLH  &kp FSLH  &kp PIPE   &none                                                                          &none       &kp AMPS   &kp STAR  &kp MINUS &kp UNDER  &kp COLON  &kp SEMI
&kp ESC    &kp LPAR  &kp LBKT  &kp LBRC  &kp LT    &kp EQUAL  &kp EXCL      &kp AT        &kp HASH       &kp DLLR   &kp PRCNT  &kp CARET    &kp PLUS &kp GT    &kp RBRC  &kp RBKT   &kp RPAR   &kp DQT
&kp LSHFT  &kp SQT   &kp DQT   &kp COMMA &kp DOT   &kp QMARK                               &trans          &trans                                          &kp AMPS  &kp STAR  &kp MINUS &kp UNDER  &kp FSLH   &kp RSHFT
&kp GRAVE  &kp SQT   &quote_pair &parens_pair &bracket_pair                         &trans       &kp DEL       &kp ESC        &kp TAB    &kp ENTER  &kp SPACE                         &brace_pair &kp MINUS &kp EQUAL &kp COLON  &kp SEMI
            >;
        };

        // =========================================================
        // LAYER 3: NUM  (hold left-thumb Delete)
        // Right-hand numpad; left side keeps navigation + readline.
        // =========================================================

        layer_num {
            display-name = "NUM";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3       &kp F4       &kp F5     &none                                                                          &none      &kp F6    &kp F7    &kp F8    &kp F9     &kp F10   &kp F11
&kp TAB    &kp HOME  &kp PG_DN &kp PG_UP    &kp END      &kp BSPC   &none                                                                          &none      &kp N7    &kp N8    &kp N9    &kp MINUS  &kp PLUS  &kp BSPC
&kp ESC    &kp LC(A) &kp LC(E) &kp LC(U)    &kp LC(K)    &kp LC(W)  &kp LGUI      &kp LCTRL     &kp LALT       &kp RALT  &kp RCTRL &kp RGUI     &kp N4  &kp N5    &kp N6    &kp STAR   &kp FSLH  &kp ENTER
&kp LSHFT  &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT    &kp DEL                                  &trans          &trans                                         &kp N1    &kp N2    &kp N3    &kp DOT    &kp COMMA  &kp RSHFT
&kp ESC    &kp TAB   &kp BSPC  &kp DEL      &kp EQUAL                           &trans       &trans       &kp ESC        &kp N0    &kp ENTER  &kp SPACE                        &kp N0    &kp DOT   &kp PLUS  &kp MINUS  &kp ENTER
            >;
        };

        // =========================================================
        // LAYER 4: FUN  (hold right-thumb Enter)
        // F-keys, IDE/browser commands, macOS screenshots, lock.
        // =========================================================

        layer_fun {
            display-name = "FUN";
            bindings = <
&kp ESC    &kp F1       &kp F2       &kp F3          &kp F4          &kp F5       &none                                                                          &none        &kp F6          &kp F7        &kp F8       &kp F9       &kp F10      &kp F11
&kp TAB    &kp F13      &kp F14      &kp F15         &kp F16         &kp F17      &none                                                                          &none        &kp F18         &kp F19       &kp F20      &kp F21      &kp F22      &kp F12
&kp ESC    &kp LG(S)    &kp LG(F)    &kp LG(LS(P))   &kp LG(P)       &kp LG(W)    &kp LGUI      &kp LCTRL     &kp LALT       &kp RALT    &kp RCTRL  &kp RGUI      &kp LG(LBKT) &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(RBKT)  &kp F11   &kp LC(LG(Q))
&kp LSHFT  &kp LG(Z)    &kp LG(X)    &kp LG(C)       &kp LG(V)       &kp LG(LS(Z))                            &trans          &trans                                            &kp C_PREV  &kp C_PP      &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP &kp RSHFT
&kp GRAVE  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LC(LG(Q))                         &kp BSPC      &kp DEL       &kp ESC        &kp TAB     &trans       &kp SPACE                         &kp HOME    &kp END      &kp PG_UP    &kp PG_DN    &none
            >;
        };

        // =========================================================
        // LAYER 5: SYS
        // Activated by holding NAV + SYM together.
        // BT_CLR and bootloader are intentionally combo-only.
        // =========================================================

        layer_sys {
            display-name = "SYS";
            bindings = <
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                         &none        &none           &none           &none           &none           &none           &none
&none      &none        &none        &none        &none        &none        &none                                                                         &none        &none           &none           &none           &none           &none           &none
&none      &none        &none        &none        &none        &none        &none        &none        &none        &none       &none      &none           &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI
&none      &none        &none        &none        &none        &none                                      &kp C_BRI_DN     &kp C_BRI_UP                                     &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
&none      &none        &none        &none        &none                              &none        &none        &none        &none       &none       &none                            &bl BL_INC  &bl BL_DEC   &bl BL_TOG   &kp LC(LG(Q)) &none
            >;
        };

        // =========================================================
        // LAYER 6: APP  (hold left thumb-cluster Esc)
        // Host-defined app/window-manager shortcuts, Ctrl+Alt+Gui+<key>.
        // =========================================================

        layer_app {
            display-name = "APP";
            bindings = <
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(N1))) &kp LC(LA(LG(N2))) &kp LC(LA(LG(N3))) &kp LC(LA(LG(N4))) &kp LC(LA(LG(N5))) &none                                                               &none                 &kp LC(LA(LG(N6))) &kp LC(LA(LG(N7))) &kp LC(LA(LG(N8))) &kp LC(LA(LG(N9))) &kp LC(LA(LG(N0))) &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))   &kp LC(LA(LG(Q)))  &kp LC(LA(LG(W)))  &kp LC(LA(LG(E)))  &kp LC(LA(LG(R)))  &kp LC(LA(LG(T)))  &none                                                               &none                 &kp LC(LA(LG(Y)))  &kp LC(LA(LG(U)))  &kp LC(LA(LG(I)))  &kp LC(LA(LG(O)))  &kp LC(LA(LG(P)))  &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))   &kp LC(LA(LG(A)))  &kp LC(LA(LG(S)))  &kp LC(LA(LG(D)))  &kp LC(LA(LG(F)))  &kp LC(LA(LG(G)))  &kp F13       &kp F14       &kp F15       &kp F16     &kp F17   &kp F18       &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI))) &kp LC(LA(LG(SQT)))
&kp LSHFT             &kp LC(LA(LG(Z)))  &kp LC(LA(LG(X)))  &kp LC(LA(LG(C)))  &kp LC(LA(LG(V)))  &kp LC(LA(LG(B)))                               &trans       &kp F19                                                  &kp LC(LA(LG(N))) &kp LC(LA(LG(M))) &kp LC(LA(LG(COMMA))) &kp LC(LA(LG(DOT))) &kp LC(LA(LG(FSLH))) &kp RSHFT
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(LBKT))) &kp LC(LA(LG(RBKT))) &kp LC(LA(LG(LPAR))) &kp LC(LA(LG(RPAR)))              &kp F20       &kp F21       &kp F22       &kp F23     &kp F24       &kp LC(LA(LG(SPACE)))           &kp LC(LA(LG(LEFT))) &kp LC(LA(LG(DOWN))) &kp LC(LA(LG(UP))) &kp LC(LA(LG(RIGHT))) &trans
            >;
        };
    };
};