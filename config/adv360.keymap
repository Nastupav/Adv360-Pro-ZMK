/*
 * ZMK keymap for Kinesis Advantage360 Pro
 *
 * Layers:
 *   0 BASE   QWERTY + home-row mods (GACS order)
 *   1 SYM    Symbols & F-keys (hold BSPC)
 *   2 NAV    Vim-style navigation + editing (hold SPACE)
 *   3 MOD    Bluetooth / RGB / bootloader
 *   4 WM     Window manager (hold ENTER)
 *              F13-F20 only; L/; use Alt+F13/Alt+F14
 *              Home row  = bare               → window management
 *              2nd row   = Ctrl               → workspace focus
 *              Num row   = Cmd                → resize & utilities
 *              Bottom row= Cmd+Shift          → monitor focus
 *              +Shift variants                → move window + follow
 *   5 NUM    Right-hand numpad (hold top-left key)
 *   6 APP    Quick-launch / system (hold CAPS, tap=ESC) → Ctrl+Alt+Cmd/Win+<key>
 *
 * Cross-platform:
 *   - WM layer outputs are pure F-key combos — consumed by skhd (macOS)
 *     and GlazeWM (Windows) identically.
 *   - APP layer sends Ctrl+Alt+Cmd+<key> (macOS) / Ctrl+Alt+Win+<key> (Windows).
 *   - Base layer uses LC/LA/LG which map to Ctrl/Alt/Cmd on macOS
 *     and Ctrl/Alt/Win on Windows.  Swap LGUI↔LALT in OS settings if needed.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================================================
         * LAYER 0: BASE
         *
         * ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┐         ┌──────┬──────┬──────┬──────┬──────┬──────┬──────┐
         * │  =   │  1   │  2   │  3   │  4   │  5   │ NUM  │         │ MOD  │  6   │  7   │  8   │  9   │  0   │  -   │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤         ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │ TAB  │  Q   │  W   │  E   │  R   │  T   │PrtSc │         │ Menu │  Y   │  U   │  I   │  O   │  P   │  \   │
         * ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤         ├──────┼──────┼──────┼──────┼──────┼──────┼──────┤
         * │ ESC  │GUI/A │ALT/S │CTL/D │SFT/F │  G   │Cp/Ps │ L  C  R│Cp/Ps │  H   │SFT/J │CTL/K │ALT/L │GUI/; │  '   │
         * ├──────┼──────┼──────┼──────┼──────┼──────┤      │ Ctrl Alt│      ├──────┼──────┼──────┼──────┼──────┼──────┤
         * │SHIFT │  Z   │  X   │  C   │  V   │  B   │      │APP PgUp│      │  N   │  M   │  ,   │  .   │  /   │SHIFT │
         * ├──────┼──────┼──────┼──────┼──────┤      │      │        │      │      ├──────┼──────┼──────┼──────┼──────┤
         * │  `   │  (   │  )   │ LEFT │RIGHT │      │      │        │      │      │  UP  │DOWN  │  [   │  ]   │ NAV  │
         * └──────┴──────┴──────┴──────┴──────┘      │      │        │      │      └──────┴──────┴──────┴──────┴──────┘
         *                        ┌─────────┬────────┤      │        │      ├────────┬─────────┐
         *                        │SYM/BSPC │NUM/DEL │SH/End│KApp    │WM/Ent│NAV/SPC │
         *                        └─────────┴────────┴──────┘        └──────┴────────┴─────────┘
         * ========================================================= */

        default_layer {
            bindings = <
&kp EQUAL  &kp N1                &kp N2                 &kp N3       &kp N4       &kp N5  &mo 5                                                                            &mo 3               &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q                 &kp W                  &kp E        &kp R        &kp T   &kp PRINTSCREEN                                                                  &kp K_CONTEXT_MENU  &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A            &hm LALT S             &hm LCTRL D  &hm LSHFT F  &kp G   &mt LC(V) LC(C)  &kp LCTRL  &kp LEFT_ALT       &kp RCTRL  &kp RIGHT_COMMAND  &mt LC(V) LC(C)     &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z                 &kp X                  &kp C        &kp V        &kp B                                &lt 6 ESC          &kp PG_UP                                           &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT     &kp RIGHT            &lt 1 BSPC       &lt 5 DEL  &mt LSHFT END      &kp K_APP  &lt 4 ENTER        &lt 2 SPACE                 &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 2
            >;
        };

        /* =========================================================
         * LAYER 1: SYM  (hold BSPC)
         *
         * Left hand  = F-keys (F1-F5) + shifted symbols
         * Right hand = F-keys (F6-F12) + paired brackets
         * Home row   = brackets & braces for programming
         * ========================================================= */

        layer_sym {
            bindings = <
&trans    &kp F1     &kp F2     &kp F3    &kp F4    &kp F5     &kp C_AL_KEYBOARD_LAYOUT                                                  &kp INS    &kp F6     &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans    &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT  &kp K_PLAY_PAUSE                                                          &kp CAPS   &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp F12
&trans    &kp LBRC   &kp RBRC   &kp LBKT  &kp RBKT  &kp GRAVE  &kp PAUSE_BREAK           &kp KP_NUM  &kp UNDER      &kp MINUS  &kp PLUS  &kp EQUAL  &kp COLON  &kp SEMI  &kp BSLH  &kp PIPE  &kp LT    &kp GT
&kp BSLH  &kp TILDE  &kp GRAVE  &kp LPAR  &kp RPAR  &kp PRCNT                                        &kp QMARK      &kp SQT                        &kp COMMA  &kp DOT   &kp FSLH  &kp STAR  &kp PLUS  &trans
&trans    &trans     &trans     &trans    &trans                &trans                     &trans       &trans         &trans     &trans    &trans                &trans    &trans    &trans    &trans    &trans
            >;
        };

        /* =========================================================
         * LAYER 2: NAV  (hold SPACE)
         *
         * Right hand = Vim-style HJKL arrows + Home/End/PgUp/PgDn
         * Left hand  = Word-level ops (Ctrl+arrows, Ctrl+Bspc/Del)
         * ========================================================= */

        layer_nav {
            bindings = <
&trans  &trans        &trans         &trans        &trans       &trans  &kp LC(Z)                                      &kp LC(Y)  &trans       &trans    &trans          &trans        &trans     &trans
&trans  &none         &kp LC(LEFT)   &kp LC(C)     &kp LC(V)    &kp LC(X)  &kp LC(A)                                  &none      &kp LC(TAB)  &kp HOME  &kp PAGE_DOWN   &kp PG_UP     &kp END    &none
&trans  &kp LGUI      &kp LALT       &kp LCTRL     &kp LSHFT    &none      &kp LC(C)  &trans  &trans      &trans  &trans  &none   &kp LEFT     &kp DOWN  &kp UP_ARROW    &kp RIGHT     &none      &trans
&trans  &kp LC(Z)     &kp LC(X)      &kp LC(C)     &kp LC(V)    &kp LC(Y)                     &trans      &trans                  &kp HOME     &kp PG_DN &kp PG_UP       &kp END       &none      &trans
&trans  &trans        &trans         &trans        &trans               &kp DEL    &kp BSPC &trans      &trans  &trans  &trans                  &trans    &trans          &trans        &trans     &trans
            >;
        };

        /* =========================================================
         * LAYER 3: MOD  (BT / RGB / bootloader)
         * ========================================================= */

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans           &none            &none            &none            &none            &none            &none
&none  &none         &none         &none         &none         &none         &bootloader                                       &bootloader      &none            &none            &none            &none            &none            &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&none  &none         &none         &none         &none         &none                             &none      &none                               &none            &bl BL_ON        &bl BL_OFF       &bl BL_CYCLE     &none            &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                             &bl BL_INC       &bl BL_DEC       &none            &none            &none
            >;
        };

        /* =========================================================
         * LAYER 4: WM  (hold ENTER)
         *
         * Uses F13-F20 only (macOS natively supports these).
         * Columns L and ; use Alt as a column marker.
         *
         * Column map:
         *   A=F13  S=F14  D=F15  F=F16  G=F17
         *   H=F18  J=F19  K=F20  L=Alt+F13  ;=Alt+F14
         *
         * Row modifiers (consumed by skhd / GlazeWM):
         *   HOME ROW   (bare)       → window management
         *   +SHIFT                  → move / swap
         *     ⚠ Use physical corner LSHFT/RSHFT keys.
         *       hm LSHFT F is a BASE-layer mod only — in WM layer F sends
         *       bare F16, not Shift.  Home-row Shift is inactive here.
         *   2ND ROW    (Ctrl)       → focus workspace 1-10
         *   +SHIFT     (Ctrl+Shift) → move to workspace 1-10
         *     ⚠ Same corner-Shift rule applies.
         *   NUM ROW    (Cmd)        → resize & utilities
         *   BOTTOM ROW (Cmd+Shift)  → left half: monitor focus 1-5
         *                             right half: space create/destroy,
         *                             native-fullscreen, send-to-display-3,
         *                             focus-recent  (see skhd for details)
         * ========================================================= */

        layer_wm {
            bindings = <
&trans  &kp LG(F13)      &kp LG(F14)      &kp LG(F15)      &kp LG(F16)      &kp LG(F17)      &none                                                  &none            &kp LG(F18)      &kp LG(F19)      &kp LG(F20)      &kp LG(LA(F13))  &kp LG(LA(F14))  &none
&trans  &kp LC(F13)      &kp LC(F14)      &kp LC(F15)      &kp LC(F16)      &kp LC(F17)      &none                                                  &none            &kp LC(F18)      &kp LC(F19)      &kp LC(F20)      &kp LC(LA(F13))  &kp LC(LA(F14))  &trans
&trans  &kp F13          &kp F14          &kp F15          &kp F16          &kp F17          &none            &trans  &trans      &trans  &trans  &none            &kp F18          &kp F19          &kp F20          &kp LA(F13)      &kp LA(F14)      &none
&trans  &kp LG(LS(F13))  &kp LG(LS(F14))  &kp LG(LS(F15))  &kp LG(LS(F16))  &kp LG(LS(F17))                          &none       &none                            &kp LG(LS(F18))  &kp LG(LS(F19))  &kp LG(LS(F20))  &kp LG(LS(LA(F13)))  &kp LG(LS(LA(F14)))  &trans
&trans  &trans           &trans           &trans           &trans                            &trans           &trans  &trans      &trans  &trans  &trans                            &trans           &trans           &trans           &trans           &none
            >;
        };

        /* =========================================================
         * LAYER 5: NUMPAD  (hold top-left key)
         *
         * Right hand = numpad 0-9 with operators
         * Left hand  = common symbols (!@#$%) for quick data entry
         * ========================================================= */

        layer_numpad {
            bindings = <
&trans  &trans    &trans  &trans     &trans    &trans       &trans                                                                 &trans  &trans           &kp MINUS     &kp PLUS      &kp EQUAL     &kp PIPE       &trans
&trans  &trans    &trans  &trans     &trans    &trans       &kp KP_SLASH                                                           &trans  &trans           &kp N7        &kp N8        &kp N9        &kp BACKSLASH  &trans
&trans  &kp EXCL  &kp AT  &kp POUND  &kp DLLR  &kp PERCENT  &kp KP_MULTIPLY  &trans  &trans            &trans       &trans         &trans  &kp LOCKING_NUM  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp DOT        &trans
&trans  &trans    &trans  &trans     &trans    &trans                                 &kp KP_MINUS      &kp KP_PLUS                         &kp N0           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH      &trans
&trans  &trans    &trans  &trans     &trans                 &trans           &trans   &trans            &trans       &kp BACKSPACE  &trans                   &kp N0        &trans        &trans        &trans         &trans
            >;
        };

        /* =========================================================
         * LAYER 6: APP  (hold CAPS, tap=ESC)
         *
         * CAPS was changed from tap=CAPS_LOCK to tap=ESC to prevent
         * accidental macOS CAPS lock toggling when quickly activating
         * this layer.  If you need CAPS lock, hold Shift and tap Shift.
         *
         * Every key sends Ctrl+Alt+Cmd+<key> (macOS) / Ctrl+Alt+Win+<key> (Windows).
         * Consumed by skhd on macOS and GlazeWM on Windows for:
         *   - App launching / switching
         *   - Raycast commands
         *   - OBS scene switching (number row)
         *   - BetterTouchTool triggers (F1-F4)
         *   - System utilities
         *
         * This layer intentionally maps EVERY physical key position
         * so you can assign any app/action to any key on either OS.
         * ========================================================= */

        layer_app {
            bindings = <
&kp LC(LA(LG(EQUAL)))  &kp LC(LA(LG(N1)))     &kp LC(LA(LG(N2)))  &kp LC(LA(LG(N3)))    &kp LC(LA(LG(N4)))     &kp LC(LA(LG(N5)))  &kp LC(LA(LG(F1)))                                                                                                 &kp LC(LA(LG(F2)))     &kp LC(LA(LG(N6)))  &kp LC(LA(LG(N7)))  &kp LC(LA(LG(N8)))     &kp LC(LA(LG(N9)))    &kp LC(LA(LG(N0)))    &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))    &kp LC(LA(LG(Q)))      &kp LC(LA(LG(W)))   &kp LC(LA(LG(E)))     &kp LC(LA(LG(R)))      &kp LC(LA(LG(T)))   &kp LC(LA(LG(F3)))                                                                                                 &kp LC(LA(LG(F4)))     &kp LC(LA(LG(Y)))   &kp LC(LA(LG(U)))   &kp LC(LA(LG(I)))      &kp LC(LA(LG(O)))     &kp LC(LA(LG(P)))     &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))    &kp LC(LA(LG(A)))      &kp LC(LA(LG(S)))   &kp LC(LA(LG(D)))     &kp LC(LA(LG(F)))      &kp LC(LA(LG(G)))   &kp LC(LA(LG(F5)))    &kp LC(LA(LG(F6)))   &kp LC(LA(LG(F7)))        &kp LC(LA(LG(F8)))     &kp LC(LA(LG(F9)))     &kp LC(LA(LG(F10)))    &kp LC(LA(LG(H)))   &kp LC(LA(LG(J)))   &kp LC(LA(LG(K)))      &kp LC(LA(LG(L)))     &kp LC(LA(LG(SEMI)))  &kp LC(LA(LG(SQT)))
&kp LC(LA(LG(LSHFT)))  &kp LC(LA(LG(Z)))      &kp LC(LA(LG(X)))   &kp LC(LA(LG(C)))     &kp LC(LA(LG(V)))      &kp LC(LA(LG(B)))                                              &kp LC(LA(LG(HOME)))      &kp LC(LA(LG(PG_UP)))                                                &kp LC(LA(LG(N)))   &kp LC(LA(LG(M)))   &kp LC(LA(LG(COMMA)))  &kp LC(LA(LG(DOT)))   &kp LC(LA(LG(FSLH)))  &kp LC(LA(LG(RSHFT)))
&kp LC(LA(LG(GRAVE)))  &kp LC(LA(LG(GRAVE)))  &trans              &kp LC(LA(LG(LEFT)))  &kp LC(LA(LG(RIGHT)))                      &kp LC(LA(LG(BSPC)))  &kp LC(LA(LG(DEL)))  &kp LC(LA(LG(END)))       &kp LC(LA(LG(PG_DN)))  &kp LC(LA(LG(ENTER)))  &kp LC(LA(LG(SPACE)))                      &kp LC(LA(LG(UP)))  &kp LC(LA(LG(DOWN)))   &kp LC(LA(LG(LBKT)))  &kp LC(LA(LG(RBKT)))  &kp LC(LA(LG(F11)))
            >;
        };
    };
};
