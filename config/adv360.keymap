/*
 * ZMK keymap for Kinesis Advantage360 Pro
 *
 * Layers:
 * 0 BASE (QWERTY + HRM)
 * 1 SYM  (hold BSPC/DEL)
 * 2 NAV  (hold SPACE)
 * 3 MOD  (BT/RGB/boot)
 * 4 WM   (hold ENTER) -> GlazeWM API via F13..F24 + modifiers
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Home Row Mods (your HRM)
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;

            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";

            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // Pairing macros (programming)
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_PAREN";
            bindings = <&macro_tap &kp LPAR>, <&macro_tap &kp RPAR>, <&macro_tap &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_BRACE";
            bindings = <&macro_tap &kp LBRC>, <&macro_tap &kp RBRC>, <&macro_tap &kp LEFT>;
        };

        pair_bracket: pair_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_BRACKET";
            bindings = <&macro_tap &kp LBKT>, <&macro_tap &kp RBKT>, <&macro_tap &kp LEFT>;
        };

        pair_dq: pair_dq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_DQUOTE";
            bindings = <&macro_tap &kp DOUBLE_QUOTES>, <&macro_tap &kp DOUBLE_QUOTES>, <&macro_tap &kp LEFT>;
        };

        pair_sq: pair_sq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_SQUOTE";
            bindings = <&macro_tap &kp SQT>, <&macro_tap &kp SQT>, <&macro_tap &kp LEFT>;
        };

        // Your AFN macro kept as-is (from your last file)
        afn: afn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "AFN";
            bindings = <
                &none
                &macro_tap &kp LPAR  &macro_tap &kp SPACE &macro_tap &kp RPAR &macro_tap &kp SPACE
                &macro_tap &kp LS(S) &macro_tap &kp P &macro_tap &kp A &macro_tap &kp C &macro_tap &kp E
                &macro_tap &kp SPACE &macro_tap &kp EQUAL &macro_tap &kp SPACE &macro_tap &kp GT &macro_tap &kp SPACE
                &macro_tap &kp LS(S) &macro_tap &kp P &macro_tap &kp A &macro_tap &kp C &macro_tap &kp E
                &macro_tap &kp SPACE &macro_tap &kp LBRC &macro_tap &kp SPACE &macro_tap &kp RBRC &macro_tap &kp SPACE
                &macro_tap &kp LS(L) &macro_tap &kp E &macro_tap &kp F &macro_tap &kp T
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0: BASE (QWERTY + HRM)
        // =========================================================
        default_layer {
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4            &kp N5  &none                                                      &mo 3        &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R             &kp T   &trans                                                     &trans       &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &trans      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans       &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V             &kp B                          &kp HOME      &kp PG_UP                          &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                 &lt 1 BSPC  &lt 1 DEL  &kp END       &kp PG_DN  &lt 4 ENTER  &lt 2 SPACE          &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 2
            >;
        };

        // =========================================================
        // LAYER 1: SYM (hold BSPC/DEL)
        // =========================================================
        layer_sym {
            bindings = <
&trans  &kp F1      &kp F2       &kp F3       &kp F4        &kp F5     &afn                                           &none  &kp F6    &kp F7     &kp F8     &kp F9     &kp F10          &kp F11
&trans  &kp EXCL    &kp AT       &kp HASH     &kp DLLR      &kp PRCNT  &none                                          &none  &kp CARET &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR         &kp F12
&trans  &kp LBRC    &kp RBRC     &kp LBKT     &kp RBKT      &kp PIPE   &pair_brace   &pair_bracket &pair_paren &pair_dq &pair_sq   &none  &kp UNDER &kp MINUS &kp PLUS  &kp EQUAL &kp COLON &kp SEMI &trans
&trans  &kp LT      &kp GT       &kp BSLH     &kp GRAVE     &kp TILDE                 &trans        &trans                 &trans  &kp QMARK &kp SQT    &kp COMMA &kp DOT    &kp FSLH &trans
&trans  &trans      &trans       &trans       &trans                 &trans    &trans    &trans       &trans     &trans   &trans                &trans    &trans    &trans    &trans    &trans   &trans
            >;
        };

        // =========================================================
        // LAYER 2: NAV (hold SPACE)
        // =========================================================
        layer_nav {
            bindings = <
&trans  &trans        &trans         &trans          &trans         &trans  &none                                     &none  &trans        &trans          &trans           &trans            &trans      &trans
&trans  &kp LC(T)     &kp LC(W)      &kp LC(R)       &kp LC(L)      &trans  &none                                     &none  &kp LC(TAB)   &kp LC(LS(TAB)) &kp HOME         &kp PG_UP         &kp PG_DN    &kp END
&trans  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(BSPC)    &kp LC(DEL)    &trans  &none   &trans  &trans   &trans  &trans  &none  &none         &kp LEFT         &kp DOWN         &kp UP       &kp RIGHT  &trans
&trans  &trans        &trans         &trans          &trans         &trans                  &trans       &trans                  &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans        &trans         &trans          &trans                &trans  &trans  &trans     &trans  &trans  &trans            &trans   &trans   &trans   &trans    &trans  &trans
            >;
        };

        // =========================================================
        // LAYER 3: MOD (BT/RGB/boot)
        // =========================================================
        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans                  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                       &bootloader             &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_MEFS_CMD 5  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                             &none      &none                                      &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                          &none  &none  &none  &none  &none
            >;
        };

        // =========================================================
        // LAYER 4: WM (hold ENTER)
        //
        // Core ideas:
        // - Window focus = J K L ;  (left/down/up/right)  -> F19..F22
        // - Move window  = hold physical Shift + (J/K/L/;) -> shift+F19..F22
        //
        // - Monitor-to-monitor workspace focus (workspace-in-direction):
        //     Z = left, X = down, C = up, V = right -> F15..F18
        //
        // - Cycle workspaces on CURRENT monitor:
        //     G = prev  -> F23
        //     B = next  -> Ctrl+F23
        //
        // - 20 workspaces (5 per monitor) as an ergonomic grid:
        //     Left monitor (1-5):      Q W E R T
        //     Mid-Top monitor (6-10):  A S D F G
        //     Mid-Bot monitor (11-15): Y U I O P
        //     Right monitor (16-20):   H N M , .
        //
        //   These emit:
        //     focus ws 1..10  = Ctrl+F13..Ctrl+F22
        //     focus ws 11..20 = Ctrl+Alt+F13..Ctrl+Alt+F22
        //
        //   Move+follow:
        //     hold physical Shift as well -> Ctrl+Shift+Fx or Ctrl+Alt+Shift+Fx
        //
        // - Toggle tiling direction = F13
        // - Toggle floating         = F14
        // - Close window            = F24
        // =========================================================
        layer_wm {
            bindings = <
&trans     &kp F13          &kp F14          &trans            &trans            &trans   &trans                                          &trans   &trans            &trans            &trans            &trans            &trans            &kp F24
&trans     &kp LC(F13)      &kp LC(F14)      &kp LC(F15)       &kp LC(F16)       &kp LC(F17)  &trans                                      &trans   &kp LC(LA(F13))   &kp LC(LA(F14))   &kp LC(LA(F15))   &kp LC(LA(F16))   &kp LC(LA(F17))   &trans
&trans     &kp LC(F18)      &kp LC(F19)      &kp LC(F20)       &kp LC(F21)       &kp LC(F22)  &trans   &trans  &trans   &trans  &trans  &trans   &kp LC(LA(F18))   &kp F23           &kp F19           &kp F20           &kp F21           &kp F22           &trans
&trans     &kp F15          &kp F18          &kp F17           &kp F16           &kp LC(LA(F19))             &trans                          &kp LC(LA(F20))   &kp LC(LA(F21))   &kp LC(LA(F22))   &kp LC(F23)       &trans
&trans     &trans           &trans           &trans           &trans                  &trans    &trans    &trans     &trans  &trans  &trans               &trans           &kp LC(F18)       &kp LC(LA(F18))   &kp LC(LA(F20))   &kp LC(LA(F21))   &kp LC(LA(F22))   &trans
            >;
        };
    };
};
