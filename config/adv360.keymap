#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // CUSTOM BEHAVIOR: Home Row Mods
        // Tap = Key, Hold = Modifier.
        // Tapping Term: 300ms (Longer wait time)
        // Flavor: Balanced (Best for reliable triggering)

        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // MACRO: Close Window (Alt + Shift + Q)
        // MACRO: Toggle Tiling (Alt + Space)
        // MACRO: Version (Mod + V) - Types "-clique"

        g_tile: g_tile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F13>;
            label = "G_TILE";
        };

        g_float: g_float {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F14>;
            label = "G_FLOAT";
        };

        g_mon_l: g_mon_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F15>;
            label = "G_MON_L";
        };

        g_mon_r: g_mon_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F16>;
            label = "G_MON_R";
        };

        prof_wk: prof_wk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F17>;
            label = "PROF_WK";
        };

        prof_ps: prof_ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F18>;
            label = "PROF_PS";
        };

        afn: afn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp SPACE &kp RPAR &kp SPACE &kp LS(S) &kp P &kp A &kp C &kp E &kp SPACE &kp EQUAL &kp SPACE &kp GT &kp SPACE &kp LS(S) &kp P &kp A &kp C &kp E &kp SPACE &kp LBRC &kp SPACE &kp RBRC &kp SPACE &kp LS(L) &kp E &kp F &kp T>;
            label = "AFN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4            &kp N5  &none                                                      &mo 3        &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R             &kp T   &g_tile                                                    &g_float     &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &g_mon_l    &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &g_mon_r     &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V             &kp B                          &kp HOME      &kp PG_UP                          &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                 &lt 1 BSPC  &lt 1 DEL  &kp END       &kp PG_DN  &kp ENTER  &lt 2 SPACE          &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 1
            >;
        };

        layer_nav {
            bindings = <
&kp F1  &kp F2            &kp F3             &kp F4                &kp F5                 &kp F6         &afn                                        &none   &kp F7    &kp F8      &kp F9      &kp F10     &kp F11            &kp F12
&trans  &none             &trans             &trans                &trans                 &trans         &none                                       &none   &trans    &kp UNDER   &kp PIPE    &kp PLUS    &kp DOUBLE_QUOTES  &trans
&trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND  &none   &trans  &trans      &trans  &trans  &none   &kp STAR  &kp EQUAL   &kp MINUS   &kp COLON   &kp SEMI           &trans
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp PERCENT                    &trans      &trans                  &kp EXCL  &kp AT      &kp HASH    &kp DLLR    &kp QMARK          &trans
&trans  &trans            &trans             &kp LA(N1)            &kp LA(N2)                            &trans  &trans  &trans      &trans  &none   &trans            &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &trans             &trans
            >;
        };

        layer_sym {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans    &trans          &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &kp HOME  &kp PG_DN       &kp PAGE_UP   &kp END    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &none   &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &none   &kp LBKT  &kp RBKT        &trans        &kp BSLH   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans          &trans        &trans     &trans
            >;
        };

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans                  &none  &none  &none  &none  &none  &none
&none  &prof_wk      &prof_ps      &none         &none         &none         &bootloader                                       &bootloader             &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_MEFS_CMD 5  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                             &none      &none                                      &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                          &none  &none  &none  &none  &none
            >;
        };
    };
};
