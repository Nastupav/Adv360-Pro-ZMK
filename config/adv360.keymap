/* Advantage360 Pro daily driver. Physical US QWERTY; host selects ABC or Czech.
 * BASE uses fast-typing-biased bilateral home-row mods; dedicated modifiers remain.
 * Layers are immediate holds: SYS > NUM > SYM > NAV > BASE.
 * Thumb NUM uses the large left Delete position (66); Delete moves to 67/68.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include "macros.dtsi"

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define SYS  4
#define KEYS_L  0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64
#define KEYS_R  7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75
#define THUMBS 35 36 37 38 52 53 65 66 67 68 69 70

// Fast-typing-biased "timeless" HRMs. 150 ms prior-idle resolves rapid typing
// immediately as taps; positional triggers keep same-hand rolls as letters.
#define HRM_TAPPING_TERM_MS 280
#define HRM_QUICK_TAP_MS 175
#define HRM_PRIOR_IDLE_MS 150

// The pinned Caps Word only auto-continues number-row digits; add keypad digits.
&caps_word {
    continue-list = <UNDERSCORE BACKSPACE DELETE KP_N0 KP_N1 KP_N2 KP_N3
                     KP_N4 KP_N5 KP_N6 KP_N7 KP_N8 KP_N9>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <HRM_QUICK_TAP_MS>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM_MS>;
            quick-tap-ms = <HRM_QUICK_TAP_MS>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Hold SYS, then both outer number-row keys. Clears ONLY selected host bond.
        combo_bt_clear {
            timeout-ms = <150>;
            // Refuse to arm during recent text entry; intentional maintenance should follow a pause.
            require-prior-idle-ms = <300>;
            key-positions = <0 13>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        // BASE HRMs: ASDF = Cmd/Option/Ctrl/Shift; JKL; = Shift/Ctrl/Option/Cmd.
        // Dedicated thumb/inner modifiers remain for immediate or same-hand chords.
        layer_base {
            display-name = "BASE";
            bindings = <
                &kp EQUAL           &kp N1              &kp N2              &kp N3              &kp N4              &kp N5              &kp F11             &kp F12             &kp N6              &kp N7              &kp N8              &kp N9              &kp N0              &kp MINUS
                &kp TAB             &kp Q               &kp W               &kp E               &kp R               &kp T               &caps_word          &kp TAB             &kp Y               &kp U               &kp I               &kp O               &kp P               &kp BSLH
                &kp ESC             &hml LGUI A          &hml LALT S          &hml LCTRL D         &hml LSHFT F         &kp G               &kp LALT            &kp LGUI            &kp LCTRL           &kp RCTRL           &kp RGUI            &kp RALT            &kp H               &hmr RSHFT J         &hmr RCTRL K         &hmr RALT L          &hmr RGUI SEMI       &kp SQT
                &kp LSHFT           &kp Z               &kp X               &kp C               &kp V               &kp B               &mo NAV             &mo SYM             &kp N               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &kp RSHFT
                &kp GRAVE           &kp LBKT            &kp RBKT            &kp LPAR            &kp RPAR            &kp BSPC            &mo NUM             &kp DEL             &kp DEL             &kp ENTER           &kp SPACE           &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &mo SYS
            >;
        };

        // NAV is a primitive layer, not an application-shortcut bank.
        // ASDF = Ctrl / Option / Command / Shift. JKL; = Left / Down / Up / Right.
        // H / quote, U / P and Y / backslash add macOS line, word and document motion.
        layer_nav {
            display-name = "NAV";
            bindings = <
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp LG(UP)          &kp LA(LEFT)        &kp PG_DN           &kp PG_UP           &kp LA(RIGHT)       &kp LG(DOWN)
                &trans              &kp LCTRL           &kp LALT            &kp LGUI            &kp LSHFT           &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp LG(LEFT)        &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp LG(RIGHT)
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp LA(BSPC)        &kp LA(DEL)         &kp BSPC            &kp DEL             &kp LG(BSPC)        &trans
                &kp HOME            &kp END             &kp LC(HOME)        &kp LC(END)         &kp INS             &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans
            >;
        };

        // ABC/US symbols, individual repeatable keypresses; no text macros.
        layer_sym {
            display-name = "SYM";
            bindings = <
                &trans              &kp EXCL            &kp AT              &kp HASH            &kp DLLR            &kp PRCNT           &trans              &trans              &kp CARET           &kp AMPS            &kp ASTRK           &kp LPAR            &kp RPAR            &trans
                &trans              &kp TILDE           &kp GRAVE           &kp BSLH            &kp PIPE            &kp SEMI            &trans              &trans              &kp DQT             &kp SQT             &kp QMARK           &kp FSLH            &kp BSLH            &trans
                &trans              &kp LBRC            &kp LBKT            &kp LPAR            &kp COLON           &kp LT              &trans              &trans              &trans              &trans              &trans              &trans              &kp GT              &kp UNDER           &kp RPAR            &kp RBKT            &kp RBRC            &kp EQUAL
                &trans              &kp EXCL            &kp DLLR            &kp MINUS           &kp PLUS            &kp ASTRK           &trans              &trans              &kp FSLH            &kp PIPE            &kp COMMA           &kp DOT             &kp PRCNT           &trans
                &kp AT              &kp HASH            &kp AMPS            &kp CARET           &kp TILDE           &trans              &trans              &trans              &trans              &trans              &trans              &kp LT              &kp GT              &kp SEMI            &kp EQUAL           &trans
            >;
        };

        // Physical UIO / JKL / M,. grid. Keypad digits/operators; ordinary dot/comma.
        layer_num {
            display-name = "NUM";
            bindings = <
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp KP_DIVIDE       &kp KP_N7           &kp KP_N8           &kp KP_N9           &kp KP_MULTIPLY     &kp COMMA
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp KP_MINUS        &kp KP_N4           &kp KP_N5           &kp KP_N6           &kp KP_PLUS         &kp KP_EQUAL
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp KP_N0           &kp KP_N1           &kp KP_N2           &kp KP_N3           &kp DOT             &trans
                &trans              &trans              &trans              &trans              &trans              &trans              &trans              &trans              &kp BSPC            &trans              &kp KP_N0           &kp KP_N0           &kp DOT             &kp KP_EQUAL        &kp ENTER           &trans
            >;
        };

        // Hold SYS deliberately. Boot 6 = left, 7 = right; reset 20 = left, 21 = right.
        layer_sys {
            display-name = "SYS";
            bindings = <
                &out OUT_USB        &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_SEL 3        &bt BT_SEL 4        &bootloader         &bootloader         &out OUT_BLE        &out OUT_TOG        &bt BT_NXT          &bt BT_PRV          &kp C_BRI_DN        &kp C_BRI_UP
                &trans              &kp F1              &kp F2              &kp F3              &kp F4              &kp F5              &sys_reset          &sys_reset          &kp F6              &kp F7              &kp F8              &kp F9              &kp F10             &none
                &trans              &kp F11             &kp F12             &none               &none               &none               &trans              &trans              &trans              &trans              &trans              &trans              &none               &none               &none               &none               &none               &none
                &trans              &bl BL_TOG          &bl BL_DEC          &bl BL_INC          &rgb_ug RGB_TOG     &rgb_ug RGB_EFF     &trans              &trans              &kp C_PREV          &kp C_PP            &kp C_NEXT          &kp C_VOL_DN        &kp C_VOL_UP        &trans
                &kp CAPS            &kp KP_NUM          &rgb_ug RGB_BRD     &rgb_ug RGB_BRI     &to BASE            &kp BSPC            &trans              &kp DEL             &kp DEL             &kp ENTER           &kp SPACE           &kp C_MUTE          &kp C_STOP          &kp C_EJECT         &kp GLOBE           &trans
            >;
        };
    };
};
