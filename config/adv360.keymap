/*
 * Kinesis Advantage360 Pro / ZMK
 * Six-layer production developer keymap.
 *
 * Contract:
 * - Plain US QWERTY isolated taps on BASE.
 * - Bilateral ASDF / JKL; home-row modifiers; G and H remain letters.
 * - Six useful momentary layers with no dead (&none) bindings.
 * - Only one BASE typing combo: Q+W -> Escape.
 * - Only four timed layer thumbs; Backspace/Delete/Enter/Space stay plain.
 * - F13-F20 plus modifiers remain the host-neutral desktop protocol.
 */

#include <behaviors.dtsi>
#include <behaviors/studio_unlock.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define NAV    1
#define SYM    2
#define NUM    3
#define GLOBAL 4
#define SYS    5

/ {
    macros {
        // Editor-independent literal tokens. Editors remain responsible for
        // auto-pairs, indentation, formatting, and snippets.
        op_eqeq: op_eqeq { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp EQUAL>, <&kp EQUAL>; };
        op_neq: op_neq { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp EXCL>, <&kp EQUAL>; };
        op_lte: op_lte { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp LT>, <&kp EQUAL>; };
        op_gte: op_gte { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp GT>, <&kp EQUAL>; };
        op_arrow: op_arrow { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp GT>; };
        op_fatarrow: op_fatarrow { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp EQUAL>, <&kp GT>; };
        op_and: op_and { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp AMPS>, <&kp AMPS>; };
        op_or: op_or { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp PIPE>, <&kp PIPE>; };
        op_walrus: op_walrus { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp COLON>, <&kp EQUAL>; };
        op_pow: op_pow { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp ASTRK>, <&kp ASTRK>; };
        op_floordiv: op_floordiv { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp FSLH>, <&kp FSLH>; };

        ps_eq: ps_eq { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp E>, <&kp Q>; };
        ps_ne: ps_ne { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp N>, <&kp E>; };
        ps_lt: ps_lt { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp L>, <&kp T>; };
        ps_le: ps_le { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp L>, <&kp E>; };
        ps_gt: ps_gt { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp G>, <&kp T>; };
        ps_ge: ps_ge { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp G>, <&kp E>; };
        op_sql_ne: op_sql_ne { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp LT>, <&kp GT>; };
        op_scope: op_scope { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp COLON>, <&kp COLON>; };
        ps_current: ps_current { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp DLLR>, <&kp UNDER>; };
        op_comment: op_comment { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <20>; tap-ms = <20>; bindings = <&kp MINUS>, <&kp MINUS>; };
    };

    behaviors {
        // Same-hand rolls remain taps; opposite-hand chords resolve the hold.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            bindings = <&kp>, <&kp>;
        };

        // Only Esc/NAV, Tab/SYM, and launcher/GLOBAL use this behavior.
        tlt_fast: thumb_layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            bindings = <&mo>, <&kp>;
        };

        // Tap Caps Word; hold NUM. The zero is ignored by &caps_word.
        num_caps: num_caps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            bindings = <&mo>, <&caps_word>;
        };

        sk_lazy: sticky_key_lazy {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
            lazy;
            bindings = <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // The only typing combo. Q+W is outside the HRM zone and low-frequency.
        combo_esc {
            timeout-ms = <35>;
            require-prior-idle-ms = <80>;
            key-positions = <15 16>;
            bindings = <&kp ESC>;
            layers = <BASE>;
        };

        // Protected maintenance chords are available only while SYS is held.
        combo_bt_clear {
            timeout-ms = <150>;
            key-positions = <1 2>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };

        combo_bootloader {
            timeout-ms = <250>;
            key-positions = <20 21>;
            layers = <SYS>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* BASE — US QWERTY taps; A/S/D/F and J/K/L/; are bilateral HRMs. */
        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &mo SYS                                  &mo SYS &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &sk_lazy LGUI                            &sk_lazy LCTRL &kp Y &kp U &kp I &kp O &kp P &kp BSLH
&kp ESC   &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G &kp LALT &kp LCTRL &kp LGUI    &kp RGUI &kp RCTRL &kp RALT &kp H &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B                              &tlt_fast NAV ESC          &tlt_fast SYM TAB                 &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
&kp GRAVE &kp LBKT &kp RBKT &kp LPAR &kp RPAR       &kp BSPC &kp DEL &num_caps NUM 0    &tlt_fast GLOBAL LA(F13) &kp ENTER &kp SPACE       &kp LEFT &kp DOWN &kp UP &kp RIGHT &mo SYS
            >;
        };

        /* NAV — ASDF document movement; G/H words; JKL; directions. */
        layer_nav {
            display-name = "NAV";
            bindings = <
&kp ESC &kp LG(LEFT) &kp LA(LEFT) &kp LC(LEFT) &kp HOME &kp PG_UP &trans                &trans &kp PG_DN &kp END &kp LC(RIGHT) &kp LA(RIGHT) &kp LG(RIGHT) &kp DEL
&trans &kp LG(LBKT) &kp LG(RBKT) &kp LC(PG_UP) &kp LC(PG_DN) &kp LG(UP) &trans          &trans &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &kp BSPC &kp DEL
&kp ESC &kp HOME &kp PG_DN &kp PG_UP &kp END &kp LA(LEFT) &trans &trans &trans           &trans &trans &trans &kp LA(RIGHT) &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp ENTER
&kp LSHFT &kp LS(HOME) &kp LS(PG_DN) &kp LS(PG_UP) &kp LS(END) &kp LS(LA(LEFT))        &trans &trans        &kp LS(LA(RIGHT)) &kp LS(LEFT) &kp LS(DOWN) &kp LS(UP) &kp LS(RIGHT) &kp RSHFT
&kp LG(Z) &kp LG(LS(Z)) &kp LG(X) &kp LG(C) &kp LG(V)       &trans &trans &trans          &trans &mkp LCLK &mkp RCLK       &mkp MCLK &kp LC(LEFT) &kp LC(DOWN) &kp LC(UP) &trans
            >;
        };

        /* SYM — symbols plus 21 literal Python/SQL/PowerShell/Bash tokens. */
        layer_sym {
            display-name = "SYM";
            bindings = <
&kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &trans                            &trans &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER &kp PLUS
&op_eqeq &op_neq &op_lte &op_gte &op_arrow &op_fatarrow &trans                          &trans &op_and &op_or &op_walrus &op_pow &op_floordiv &op_scope
&kp ESC &kp UNDER &kp COLON &kp EXCL &kp QMARK &kp EQUAL &trans &trans &trans            &trans &trans &trans &kp MINUS &kp PLUS &kp ASTRK &kp AMPS &kp PIPE &kp DQT
&kp LSHFT &ps_eq &ps_ne &ps_lt &ps_le &ps_gt                              &trans          &trans          &ps_ge &op_sql_ne &ps_current &op_comment &kp LT &kp RSHFT
&kp GRAVE &kp LBKT &kp RBKT &kp LBRC &kp RBRC       &trans &trans &trans                  &trans &trans &trans       &kp LPAR &kp RPAR &kp SQT &kp SEMI &trans
            >;
        };

        /* NUM — F1-F12, right numpad, and VS Code run/debug keys on ASDFG. */
        layer_num {
            display-name = "NUM";
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &trans                                       &trans &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&kp N7 &kp N8 &kp N9 &kp N4 &kp N5 &kp N6 &trans                                       &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_DIVIDE &kp KP_MULTIPLY &kp BSPC
&kp ESC &kp F5 &kp F9 &kp F10 &kp F11 &kp F12 &trans &trans &trans                       &trans &trans &trans &kp KP_MINUS &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS &kp KP_MULTIPLY
&kp LSHFT &kp F2 &kp F12 &kp LS(F12) &kp LS(F5) &kp DEL                    &trans         &trans        &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT &kp KP_DIVIDE &kp RSHFT
&kp F7 &kp F8 &kp F9 &kp F10 &kp F11       &trans &trans &trans                           &kp KP_N0 &kp KP_DOT &kp KP_ENTER       &kp KP_PLUS &kp KP_MINUS &kp KP_MULTIPLY &kp KP_DIVIDE &trans
            >;
        };

        /* GLOBAL — stable F13-F20 host protocol for AeroSpace/Hyprland. */
        layer_global {
            display-name = "GLOBAL";
            bindings = <
&trans &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &trans                                    &trans &kp F18 &kp F19 &kp F20 &trans &trans &trans
&trans &trans &kp LA(F15) &kp LA(F17) &trans &kp LA(F14) &trans                           &trans &trans &kp LA(F19) &kp LA(F20) &kp LA(F16) &kp LA(F18) &trans
&trans &kp LC(LS(F19)) &kp LC(LS(F20)) &kp LC(F20) &kp LC(F19) &kp LC(F17) &trans &trans &trans   &trans &trans &trans &kp LC(F18) &kp LC(F13) &kp LC(F14) &kp LC(F15) &kp LC(F16) &trans
&trans &kp LS(F13) &kp LS(F14) &kp LS(F15) &kp LS(F16) &kp LS(F17)               &trans   &trans        &kp LS(F18) &kp LS(F19) &kp LS(F20) &kp LC(LS(F13)) &kp LC(LS(F14)) &trans
&kp LC(F19) &kp LC(F17) &kp LC(F18) &kp LC(F20) &kp LC(LS(F19))       &trans &trans &trans    &trans &trans &trans       &kp LC(LS(F20)) &kp LC(F13) &kp LC(F14) &kp LC(F15) &trans
            >;
        };

        /* SYS — Bluetooth/output/Studio, media, lighting, and maintenance. */
        layer_sys {
            display-name = "SYS";
            bindings = <
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans            &trans &trans &trans &trans &trans &trans &trans
&trans &kp C_PREV &kp C_VOL_DN &kp C_PP &kp C_VOL_UP &kp C_NEXT &trans                    &trans &kp C_MUTE &studio_unlock &bl BL_TOG &bl BL_DEC &bl BL_INC &trans
&kp ESC &out OUT_USB &out OUT_BLE &out OUT_TOG &bt BT_NXT &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &kp C_PREV &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR
&kp LSHFT &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP              &trans      &trans       &kp C_MUTE &bl BL_TOG &bl BL_DEC &bl BL_INC &rgb_ug RGB_TOG &kp RSHFT
&rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_SPI       &trans &trans &trans   &rgb_ug RGB_SPD &rgb_ug RGB_EFF &rgb_ug RGB_EFR       &bl BL_TOG &bl BL_DEC &bl BL_INC &kp C_MUTE &trans
            >;
        };
    };
};
