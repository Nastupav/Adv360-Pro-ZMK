/*
 * ZMK keymap for Kinesis Advantage360 Pro
 *
 * Layer model:
 *   0 BASE     typing + home-row mods
 *   1 NAV      movement, selection, edit actions
 *   2 SYM      coding symbols and delimiters
 *   3 NUM      numpad + function keys
 *   4 WM       GlazeWM focus/manage layer
 *   5 SYS      keyboard system controls
 *   6 WMSEND   GlazeWM send/move layer
 *
 * Thumb model:
 *   BSPC hold -> SYM
 *   DEL  hold -> NUM
 *   ESC  hold -> SYS
 *   ENTER hold -> WM
 *   SPACE hold -> NAV
 *
 * WM model:
 *   Hold ENTER for focus/manage.
 *   While in WM, hold the left thumb send key to access WMSEND.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <110>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        th: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <110>;
            require-prior-idle-ms = <120>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5    &kp F11                                                        &kp F12      &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS
&kp ESC    &kp Q        &kp W        &kp E        &kp R        &kp T     &kp PRINTSCREEN                                                &kp K_CONTEXT_MENU  &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSLH
&kp TAB    &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSHFT F  &kp G     &kp K_UNDO   &kp K_CUT    &kp K_COPY    &kp K_PASTE  &kp K_REDO   &kp INSERT   &kp H        &hm RSHFT J  &hm RCTRL K  &hm RALT L   &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C        &kp V        &kp B                               &th 5 ESC      &kp PG_UP                               &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
&kp GRAVE  &kp LBKT     &kp RBKT     &kp LEFT     &kp RIGHT              &th 2 BSPC    &th 3 DEL    &kp TAB      &kp PG_DN    &th 4 ENTER   &th 1 SPACE              &kp UP       &kp DOWN     &kp LBRC     &kp RBRC     &kp PIPE
            >;
        };

        layer_nav {
            bindings = <
&trans  &trans           &trans              &trans             &trans              &trans             &trans                                                     &trans             &trans         &trans         &trans         &trans         &trans         &trans
&trans  &kp K_FIND       &kp LC(LS(TAB))     &kp LC(TAB)        &kp K_UNDO          &kp K_REDO         &trans                                                     &trans             &kp LA(LEFT)   &kp LC(PG_UP)  &kp LC(PG_DN)  &kp LA(RIGHT)  &kp DEL        &trans
&trans  &kp HOME         &kp LC(LEFT)        &kp LC(RIGHT)      &kp END             &kp LC(HOME)       &kp K_UNDO   &kp K_CUT    &kp K_COPY    &kp K_PASTE  &kp K_REDO   &kp LC(A)    &kp LC(END)   &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
&trans  &kp LS(HOME)     &kp LC(LS(LEFT))    &kp LC(LS(RIGHT))  &kp LS(END)         &kp LC(BSPC)                            &trans       &trans                                &kp LC(DEL)     &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)     &kp LS(RIGHT)  &trans
&trans  &trans           &trans              &trans             &trans                        &kp DEL         &kp BSPC     &kp TAB      &kp ENTER    &trans        &trans                    &kp PG_UP     &kp PG_DN     &trans        &trans        &trans
            >;
        };

        layer_sym {
            bindings = <
&trans  &kp F1       &kp F2       &kp F3      &kp F4      &kp F5      &trans                                                        &trans        &kp F6       &kp F7      &kp F8      &kp F9      &kp F10      &kp F11
&trans  &kp EXCL     &kp AT       &kp HASH    &kp DLLR    &kp PRCNT   &trans                                                        &trans        &kp CARET    &kp AMPS    &kp STAR    &kp QMARK   &kp TILDE    &kp F12
&trans  &kp LPAR     &kp LBKT     &kp LBRC    &kp LT      &kp GRAVE   &kp UNDER   &kp PLUS   &kp COLON   &kp SEMI    &kp MINUS   &kp EQUAL   &kp GT       &kp RBRC    &kp RBKT    &kp RPAR    &kp PIPE      &kp BSLH
&trans  &kp UNDER    &kp MINUS    &kp EQUAL   &kp PLUS    &kp QMARK                          &kp TAB        &kp LS(TAB)                           &kp SQT      &kp FSLH    &kp BSLH    &kp COLON   &kp SEMI     &trans
&trans  &trans       &trans       &trans      &trans                &trans         &trans       &trans       &kp TAB     &kp LS(TAB)   &trans                    &trans       &trans       &trans       &trans       &trans
            >;
        };

        layer_num {
            bindings = <
&trans  &kp F1       &kp F2          &kp F3          &kp F4         &kp F5         &kp F6                                                         &kp F7        &kp F8       &kp F9       &kp F10      &kp F11      &kp F12      &trans
&trans  &trans       &trans          &trans          &trans         &trans         &trans                                                         &trans        &kp N7       &kp N8       &kp N9       &kp KP_MINUS &kp KP_MULTIPLY &kp KP_SLASH
&trans  &kp KP_MINUS &kp KP_PLUS     &kp KP_MULTIPLY &kp KP_SLASH   &kp EQUAL      &trans      &trans     &trans      &trans      &trans      &trans       &trans        &kp N4       &kp N5       &kp N6       &kp KP_PLUS  &kp ENTER
&trans  &trans       &trans          &trans          &trans         &trans                               &trans         &trans                                &kp N1       &kp N2       &kp N3       &kp N0       &kp DOT      &kp ENTER
&trans  &trans       &trans          &trans          &trans                   &kp BSPC      &kp DEL     &kp TAB      &trans      &trans        &kp SPACE                 &trans       &trans       &trans       &trans       &trans
            >;
        };

        layer_wm {
            bindings = <
&kp LG(LA(F17))  &kp F13       &kp F14       &kp F15       &kp F16       &kp F17       &kp LG(LA(F17))                                           &kp LG(LA(F18))  &kp F18       &kp F19       &kp F20       &kp F21       &kp F22       &kp LG(LA(F19))
&none            &kp LC(F13)   &kp LC(F14)   &kp LC(F15)   &kp LC(F16)   &kp LC(F17)   &kp LG(LA(F13))                                           &kp LG(LA(F14))  &kp LA(F13)   &kp LA(F14)   &kp LA(F15)   &kp LA(F16)   &kp LA(F17)   &kp LG(LA(F15))
&none            &kp LG(F17)   &kp LG(F18)   &kp LG(F19)   &kp LG(F20)   &none         &kp LG(LC(F13)) &kp LG(LC(F14)) &kp LG(LC(F15)) &kp LG(LC(F16)) &none       &none         &none         &kp LG(F13)   &kp LG(F14)   &kp LG(F15)   &kp LG(F16)   &none
&none            &kp LG(LS(F17)) &kp LG(LS(F18)) &kp LG(LS(F19)) &kp LG(LS(F20)) &kp LG(LA(F19))                 &mo 6          &kp F24                               &kp LG(LS(F13)) &kp LG(LS(F14)) &kp LG(LS(F15)) &kp LG(LS(F16)) &kp LS(F24)   &none
&none            &none         &none         &none         &none                    &mo 6         &kp F24      &kp LS(F24)   &kp LC(F24)  &trans         &kp LA(F24)               &none         &none         &none         &none         &none
            >;
        };

        layer_sys {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                               &bootloader      &none            &none            &none            &none         &none        &none
&none  &none         &none         &none         &none         &none         &none                                                    &none            &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &bl BL_CYCLE  &bl BL_INC   &bl BL_DEC
&none  &none         &none         &none         &none         &none         &none        &none       &none        &none         &none         &none         &bl BL_ON       &bl BL_OFF    &rgb_ug RGB_BRI &rgb_ug RGB_BRD &none        &none
&none  &none         &none         &none         &none         &none                                &none          &none                                  &none           &none           &none           &none           &none         &none
&none  &none         &none         &none         &none                    &none         &none        &none         &none         &none          &none                      &none         &none         &none         &none         &none
            >;
        };

        layer_wm_send {
            bindings = <
&none  &kp LS(F13)      &kp LS(F14)      &kp LS(F15)      &kp LS(F16)      &kp LS(F17)      &none                                                    &none            &kp LS(F18)      &kp LS(F19)      &kp LS(F20)      &kp LS(F21)      &kp LS(F22)      &none
&none  &kp LC(LS(F13))  &kp LC(LS(F14))  &kp LC(LS(F15))  &kp LC(LS(F16))  &kp LC(LS(F17))  &none                                                    &none            &kp LA(LS(F13))  &kp LA(LS(F14))  &kp LA(LS(F15))  &kp LA(LS(F16))  &kp LA(LS(F17))  &none
&none  &kp LG(LS(F17))  &kp LG(LS(F18))  &kp LG(LS(F19))  &kp LG(LS(F20))  &none            &kp LG(LC(F13)) &kp LG(LC(F14)) &kp LG(LC(F15)) &kp LG(LC(F16)) &none       &none         &none         &kp LG(LS(F13))  &kp LG(LS(F14))  &kp LG(LS(F15))  &kp LG(LS(F16))  &none
&none  &kp LG(LS(F17))  &kp LG(LS(F18))  &kp LG(LS(F19))  &kp LG(LS(F20))  &kp LG(LA(F19))                   &trans         &kp F24                                &kp LG(LS(F13))  &kp LG(LS(F14))  &kp LG(LS(F15))  &kp LG(LS(F16))  &kp LS(F24)      &none
&none  &none            &none            &none            &none                       &trans         &kp F24      &kp LS(F24)   &kp LC(F24)   &trans         &kp LA(F24)                 &none            &none            &none            &none            &none
            >;
        };
    };
};
