/*
 * ZMK keymap for Kinesis Advantage360 Pro
 * Lean developer workflow redesign.
 *
 * Core control nucleus:
 *   Left:  A S D F
 *   Right: J K L ;
 *
 * Layers:
 *   0 BASE  typing + home-row mods
 *   1 SYM   programming symbols (hold BSPC)
 *   2 NAV   movement/edit/select (hold SPACE or left inner thumb)
 *   3 MOD   BT/RGB/system
 *   4 WM    window manager control (hold ENTER)
 *   5 NUM   numpad
 *   6 APP   quick launch hyper layer (hold CAPS, tap ESC)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <145>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        td_caps: tap_dance_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_CAPS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5  &mo 5                                                              &mo 3               &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T   &kp PRINTSCREEN                                                    &kp K_CONTEXT_MENU  &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G   &kp K_COPY  &kp LCTRL  &kp LEFT_ALT  &kp RCTRL  &kp RIGHT_COMMAND  &kp K_PASTE  &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B                             &td_caps 6 ESC      &kp PG_UP                              &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp LBKT    &kp RBKT    &kp LEFT     &kp RIGHT             &lt 1 BSPC       &lt 5 DEL  &lt 2 ESC       &mo 6      &lt 4 ENTER        &lt 2 SPACE            &kp UP       &kp DOWN     &kp LBRC    &kp RBRC       &mo 2
            >;
        };

        layer_sym {
            bindings = <
&trans  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp C_AL_KEYBOARD_LAYOUT                                                &trans  &kp F6      &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &trans                                                                   &trans  &kp CARET   &kp AMPS  &kp STAR  &kp TILDE &kp QMARK &kp F12
&trans  &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT  &kp LBRC  &kp GRAVE           &trans  &trans  &trans  &trans      &kp RBRC  &kp EQUAL  &kp MINUS &kp COLON &kp SEMI  &kp PIPE  &kp BSLH
&trans  &kp UNDER &kp PLUS  &kp LT    &kp GT    &kp PERCENT                              &trans      &trans                               &kp FSLH  &kp AMPS   &kp STAR  &kp COMMA &kp DOT   &kp SQT
&trans  &trans    &trans    &trans    &trans             &trans              &trans  &kp TAB   &kp LS(TAB) &trans  &trans               &trans      &trans     &trans    &trans    &trans
            >;
        };

        layer_nav {
            bindings = <
&trans  &trans      &trans      &trans       &trans       &trans      &kp K_UNDO                                             &kp K_REDO  &trans            &kp LA(LEFT)      &kp HOME           &kp END            &kp LA(RIGHT)  &trans
&trans  &kp K_FIND  &kp LC(K)   &kp LC(F2)   &kp LC(P)    &kp LC(SLASH) &kp LC(LS(TAB))                                      &kp LC(TAB) &kp LC(TAB)       &kp LEFT          &kp DOWN           &kp UP             &kp RIGHT      &kp DEL
&trans  &kp K_UNDO  &kp K_CUT   &kp K_COPY   &kp K_PASTE  &kp TAB      &kp K_COPY  &trans  &trans     &trans  &trans      &kp INSERT  &kp LEFT            &kp DOWN          &kp UP             &kp RIGHT           &kp INSERT     &trans
&trans  &kp LC(Z)   &kp LA(LEFT) &kp LG(LEFT) &kp LG(RIGHT) &kp LA(RIGHT)                   &trans      &trans                               &kp LA(LS(LEFT))  &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &kp LA(LS(RIGHT))  &kp BSPC       &trans
&trans  &trans      &trans      &trans       &trans                  &kp DEL       &kp BSPC  &trans    &trans  &kp K_UNDO   &trans                          &trans            &trans             &trans             &trans         &trans
            >;
        };

        layer_mod {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                       &trans           &trans           &trans           &trans           &trans           &trans           &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bootloader                                      &bootloader      &trans           &trans           &trans           &trans           &trans           &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans       &trans  &trans  &bt BT_CLR  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&trans  &trans        &trans        &trans        &trans        &trans                             &trans      &trans                               &trans           &bl BL_ON        &bl BL_OFF       &bl BL_CYCLE     &trans           &trans
&trans  &trans        &trans        &trans        &trans                      &trans       &trans  &trans  &trans      &trans  &trans                            &bl BL_INC       &bl BL_DEC       &trans           &trans           &trans
            >;
        };

        layer_wm {
            bindings = <
&trans  &kp LG(F13)      &kp LG(F14)      &kp LG(F15)      &kp LG(F16)      &kp LG(F17)      &trans                                                          &trans  &kp LG(F18)        &kp LG(F19)        &kp LG(F20)        &kp LG(F10)        &kp LG(F12)            &trans
&trans  &kp LC(F13)      &kp LC(F14)      &kp LC(F15)      &kp LC(F16)      &kp LC(F17)      &trans                                                          &trans  &kp LC(F18)        &kp LC(F19)        &kp LC(F20)        &kp LC(F10)        &kp LC(F12)            &trans
&trans  &kp LC(LA(LG(A))) &kp LC(LA(LG(S))) &kp LC(LA(LG(D))) &kp LC(LA(LG(F))) &kp F17       &trans  &trans  &trans  &trans  &trans  &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI)))  &trans
&trans  &kp LC(LA(LS(LG(A)))) &kp LC(LA(LS(LG(S)))) &kp LC(LA(LS(LG(D)))) &kp LC(LA(LS(LG(F)))) &kp LG(LA(F17))       &trans      &trans                           &kp LC(LA(LS(LG(H)))) &kp LC(LA(LS(LG(J)))) &kp LC(LA(LS(LG(K)))) &kp LC(LA(LS(LG(L)))) &kp LC(LA(LS(LG(SEMI)))) &trans
&trans  &trans           &trans           &trans           &trans                           &kp F24  &kp LS(F24)  &kp LG(F24)  &kp LC(F24)  &trans  &kp LA(F24)              &trans             &trans             &trans             &trans                 &trans
            >;
        };

        layer_numpad {
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans      &trans                                                         &trans     &trans        &kp MINUS  &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_PLUS  &trans
&trans  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &kp KP_SLASH                                                   &trans     &trans        &kp N7     &kp N8        &kp N9           &kp BSLH     &trans
&trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &kp KP_MULTIPLY  &trans  &trans  &trans  &trans      &trans     &kp KP_MINUS  &kp N4     &kp N5        &kp N6           &kp DOT      &trans
&trans  &trans      &trans      &trans      &trans      &trans                               &kp KP_MINUS  &kp KP_PLUS                         &kp N0    &kp N1     &kp N2        &kp N3           &kp FSLH     &trans
&trans  &trans      &trans      &trans      &trans                  &kp BSPC         &trans  &trans  &trans  &kp ENTER  &kp SPACE               &kp N0     &trans        &trans           &trans       &trans
            >;
        };

        layer_app {
            bindings = <
&kp LC(LA(LG(EQUAL)))  &kp LC(LA(LG(N1)))   &kp LC(LA(LG(N2)))       &kp LC(LA(LG(N3)))    &kp LC(LA(LG(N4)))     &kp LC(LA(LG(N5)))  &kp LC(LA(LG(F1)))                                                                                                 &kp LC(LA(LG(F2)))     &kp LC(LA(LG(N6)))  &kp LC(LA(LG(N7)))  &kp LC(LA(LG(N8)))     &kp LC(LA(LG(N9)))    &kp LC(LA(LG(N0)))    &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))    &kp LC(LA(LG(Q)))    &kp LC(LA(LG(W)))        &kp LC(LA(LG(E)))     &kp LC(LA(LG(R)))      &kp LC(LA(LG(T)))   &kp LC(LA(LG(F3)))                                                                                                 &kp LC(LA(LG(F4)))     &kp LC(LA(LG(Y)))   &kp LC(LA(LG(U)))   &kp LC(LA(LG(I)))      &kp LC(LA(LG(O)))     &kp LC(LA(LG(P)))     &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))    &kp LC(LA(LG(A)))    &kp LC(LA(LG(S)))        &kp LC(LA(LG(D)))     &kp LC(LA(LG(F)))      &kp LC(LA(LG(G)))   &kp LC(LA(LG(F5)))    &kp LC(LA(LG(F6)))   &kp LC(LA(LG(F7)))        &kp LC(LA(LG(F8)))     &kp LC(LA(LG(F9)))     &kp LC(LA(LG(F10)))    &kp LC(LA(LG(H)))   &kp LC(LA(LG(J)))   &kp LC(LA(LG(K)))      &kp LC(LA(LG(L)))     &kp LC(LA(LG(SEMI)))  &kp LC(LA(LG(SQT)))
&kp LC(LA(LG(F11)))    &kp LC(LA(LG(Z)))    &kp LC(LA(LG(X)))        &kp LC(LA(LG(C)))     &kp LC(LA(LG(V)))      &kp LC(LA(LG(B)))                                              &kp LC(LA(LG(HOME)))      &kp LC(LA(LG(PG_UP)))                                                &kp LC(LA(LG(N)))   &kp LC(LA(LG(M)))   &kp LC(LA(LG(COMMA)))  &kp LC(LA(LG(DOT)))   &kp LC(LA(LG(FSLH)))  &kp LC(LA(LG(F12)))
&kp LC(LA(LG(GRAVE)))  &kp LC(LA(LG(TAB)))  &kp LC(LA(LG(LS(TAB))))  &kp LC(LA(LG(LEFT)))  &kp LC(LA(LG(RIGHT)))                      &kp LC(LA(LG(BSPC)))  &kp LC(LA(LG(DEL)))  &kp LC(LA(LG(END)))   &kp LC(LA(LG(PG_DN)))  &kp LC(LA(LG(ENTER)))  &kp LC(LA(LG(SPACE)))                      &kp LC(LA(LG(UP)))  &kp LC(LA(LG(DOWN)))   &kp LC(LA(LG(LBKT)))  &kp LC(LA(LG(RBKT)))  &kp LC(LA(LG(PRINTSCREEN)))
            >;
        };
    };
};
