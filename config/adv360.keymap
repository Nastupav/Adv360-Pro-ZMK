/*
 * Kinesis Advantage360 Pro / ZMK — Ultimate SWE Keymap
 * macOS-primary, Windows secondary (mental Cmd↔Ctrl remap).
 *
 * DESIGN PHILOSOPHY:
 *   Every common IDE action is ≤1 thumb-hold away.
 *   NAV layer = full text editing suite. SYM layer = every symbol.
 *   FUN layer = IDE power tools + debug. APP layer = window management.
 *
 * THUMB MAP:
 *   Hold Left-Backspace → SYM (all symbols)
 *   Hold Left-Delete    → NUM (numpad)
 *   Hold Left-Esc       → APP (window manager shortcuts)
 *   Hold Right-Space    → NAV (arrows + text editing)
 *   Hold Right-Enter    → FUN (F-keys + IDE macros + debug)
 *
 * ADDED MACROS: Delete-line, Move-line-up/down, Duplicate-line, Select-all,
 *   Go-to-definition, Find-references, Rename, Debug-step-over/continue/stop
 *
 * NOTE: hold-trigger-key-positions removed — silently ignored by Kinesis fork (#596).
 *
 * Layers: 0=BASE  1=NAV  2=SYM  3=NUM  4=FUN  5=SYS  6=APP
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/studio_unlock.dtsi>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define SYS  5
#define APP  6

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // ── IDE / Text Editing ──────────────────────────────────────
        term: term {              // Terminal toggle (Ctrl+`)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp GRAVE>, <&macro_release &kp LCTRL>;
        };
        findf: findf {            // Find in files (Cmd+Shift+F)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_press &kp LSHFT>, <&macro_tap &kp F>, <&macro_release &kp LSHFT>, <&macro_release &kp LGUI>;
        };
        gitp: gitp {              // Git panel (Ctrl+Shift+G)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LSHFT>, <&macro_tap &kp G>, <&macro_release &kp LSHFT>, <&macro_release &kp LCTRL>;
        };
        delln: delln {            // Delete line (Cmd+Backspace — macOS standard)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp BSPC>, <&macro_release &kp LGUI>;
        };
        mvup: mvup {              // Move line up (Option+Up)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp UP>, <&macro_release &kp LALT>;
        };
        mvdn: mvdn {              // Move line down (Option+Down)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp DOWN>, <&macro_release &kp LALT>;
        };
        dupl: dupl {              // Duplicate line (Cmd+D — JetBrains)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp D>, <&macro_release &kp LGUI>;
        };
        selal: selal {            // Select all (Cmd+A)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp A>, <&macro_release &kp LGUI>;
        };

        // ── IDE Navigation ──────────────────────────────────────────
        godef: godef {            // Go to definition (Cmd+B / F12)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp B>, <&macro_release &kp LGUI>;
        };
        frefs: frefs {            // Find references (Shift+F12)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp F12>, <&macro_release &kp LSHFT>;
        };
        renam: renam {            // Rename symbol (F2)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_tap &kp F2>;
        };
        qfix: qfix {              // Quick fix (Cmd+.)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp DOT>, <&macro_release &kp LGUI>;
        };

        // ── Debug ───────────────────────────────────────────────────
        dbgc: dbgc {              // Debug continue (F5)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_tap &kp F5>;
        };
        dbgo: dbgo {              // Debug step over (F10)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_tap &kp F10>;
        };
        dbgi: dbgi {              // Debug step into (F11)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_tap &kp F11>;
        };
        dbgs: dbgs {              // Debug stop (Shift+F5)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp F5>, <&macro_release &kp LSHFT>;
        };
        dbgb: dbgb {              // Toggle breakpoint (F9)
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_tap &kp F9>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_clear {
            timeout-ms = <120>; key-positions = <1 2>; layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };
        combo_bootloader {
            timeout-ms = <200>; key-positions = <20 21>; layers = <SYS>;
            bindings = <&bootloader>;
        };
        // Bracket-pair combos — chord two adjacent keys → typed pair with cursor between
        combo_parens {
            timeout-ms = <30>; key-positions = <37 38>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        combo_brackets {
            timeout-ms = <30>; key-positions = <35 36>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        combo_braces {
            timeout-ms = <30>; key-positions = <43 44>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ═══════════════════════════════════════════════════════════════
        // LAYER 0: BASE — QWERTY + positional HRMs
        //   Caps Word replaces old ESC inner-thumb position.
        //   Bracket pairs ( ) [ ] { } on thumb-accessible outer columns.
        // ═══════════════════════════════════════════════════════════════
        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5   &mo SYS                                                                    &mo SYS         &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T    &none                                                                        &none           &kp Y     &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp ESC    &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G  &kp LGUI      &kp LCTRL     &kp LALT      &kp RALT    &kp RCTRL  &kp RGUI      &kp H     &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B                                  &tlt APP ESC    &kp TAB                                               &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp GRAVE  &kp LBKT  &kp RBKT  &kp LPAR   &kp RPAR               &tlt SYM BSPC &tlt NUM DEL  &caps_word      &kp TAB      &tlt FUN ENTER &tlt NAV SPACE                  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &mo SYS
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 1: NAV — Full text editing suite (hold Space)
        //
        // LEFT HAND  = clipboard, readline, save/find, undo/redo
        // RIGHT HAND = cursor movement, selection, line operations
        //
        // QUICK REFERENCE:
        //   Row 1: word-jump, tab-switch, app-switch, page-up/down
        //   Row 2: Undo/Redo/Cut/Copy/Paste | Home/Move↓/Move↑/End/Del/Bspc
        //   Row 3: readline (Ctrl+A/E/U/K/W) | Home/←/↓/↑/→/Enter
        //   Row 4: Save/Find/Reload | DupLn/SelAll/DelLn/word-sel/word-nav/Shift
        //   Row 5: Esc/Tab/Undo/Redo | Bspc/Del/Shift/Ctrl/Enter | Home/End/PgUp/PgDn
        // ═══════════════════════════════════════════════════════════════
        layer_nav {
            display-name = "NAV";
            bindings = <
// Row 1
&kp ESC    &kp LA(LEFT)  &kp LA(RIGHT)  &kp LG(LBKT)  &kp LG(RBKT)  &kp PSCRN  &none                                &none              &kp LC(LS(TAB)) &kp LC(TAB)  &kp LG(TAB)  &kp LG(LS(TAB)) &kp PG_UP    &kp PG_DN
// Row 2 — clipboard actions (left) + line operations (right)
&kp TAB    &kp LG(Z)     &kp LG(LS(Z))  &kp LG(X)     &kp LG(C)     &kp LG(V)  &none                                &none              &kp HOME        &mvdn        &mvup        &kp END         &kp DEL      &kp BSPC
// Row 3 — readline (left) + arrows (right)
&kp ESC    &kp LC(A)     &kp LC(E)      &kp LC(U)     &kp LC(K)     &kp LC(W)  &kp LGUI  &kp LCTRL  &kp LALT  &kp RALT  &kp RCTRL  &kp RGUI   &kp HOME  &kp LEFT      &kp DOWN   &kp UP       &kp RIGHT     &kp ENTER
// Row 4 — file + line editing
&kp LSHFT  &kp LG(S)     &kp LG(F)      &kp LC(R)     &dupl         &selal                         &trans         &trans                                   &delln    &kp LA(LEFT) &kp LA(RIGHT) &kp LA(LS(LEFT)) &kp LA(LS(RIGHT)) &kp LA(BSPC) &kp RSHFT
// Row 5 — thumb row
&kp ESC    &kp TAB       &kp LG(Z)      &kp LG(LS(Z)) &kp LC(L)                    &kp BSPC  &kp DEL   &kp LSHFT &kp LCTRL &kp ENTER  &trans                     &kp HOME    &kp END     &kp PG_UP  &kp PG_DN   &trans
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 2: SYM — All programming symbols (hold Backspace)
        //   Opening delimiters on left, closing on right — split-hand rhythm.
        //   Row 1: ! @ # $ % | ^ & * / \ `
        //   Row 2: ` ~ | \ " | & * - _ : ;
        //   Row 3: ( [ { < = | PLUS > } ] ) "
        //   Row 4: ' " , . ? | & * - _ /
        //   Row 5: ` ' " ( ) | _ - = : ;
        // ═══════════════════════════════════════════════════════════════
        layer_sym {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &none                                &none       &kp CARET  &kp AMPS  &kp ASTRK &kp FSLH  &kp PIPE  &kp TILDE
&kp TAB    &kp GRAVE &kp TILDE &kp PIPE  &kp BSLH  &kp DQT    &none                                &none       &kp AMPS   &kp STAR  &kp MINUS &kp UNDER  &kp COLON  &kp SEMI
&kp ESC    &kp LPAR  &kp LBRC  &kp LBRC  &kp LT     &kp EQUAL  &kp EXCL &kp AT  &kp HASH &kp DLLR &kp PRCNT &kp CARET  &kp PLUS &kp GT     &kp RBRC  &kp RBKT   &kp RPAR   &kp DQT
&kp LSHFT  &kp SQT   &kp DQT   &kp COMMA &kp DOT    &kp QMARK                         &trans         &trans                                   &kp AMPS  &kp STAR  &kp MINUS &kp UNDER  &kp FSLH   &kp RSHFT
&kp GRAVE  &kp SQT   &kp DQT   &kp LPAR  &kp RPAR                &trans  &kp DEL  &kp ESC  &kp TAB  &kp ENTER  &kp SPACE                        &kp UNDER &kp MINUS &kp EQUAL &kp COLON  &kp SEMI
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 3: NUM — Numpad (hold Delete)
        //   Right hand: full numpad. Left hand: navigation + readline.
        // ═══════════════════════════════════════════════════════════════
        layer_num {
            display-name = "NUM";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3       &kp F4       &kp F5     &none                                &none      &kp F6    &kp F7    &kp F8    &kp F9     &kp F10   &kp F11
&kp TAB    &kp HOME  &kp PG_DN &kp PG_UP    &kp END      &kp BSPC   &none                                &none      &kp N7    &kp N8    &kp N9    &kp MINUS  &kp PLUS  &kp BSPC
&kp ESC    &kp LC(A) &kp LC(E) &kp LC(U)    &kp LC(K)    &kp LC(W)  &kp LGUI &kp LCTRL &kp LALT &kp RALT &kp RCTRL &kp RGUI   &kp N4    &kp N5    &kp N6    &kp STAR   &kp FSLH  &kp ENTER
&kp LSHFT  &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT    &kp DEL                          &trans          &trans                                   &kp N1    &kp N2    &kp N3    &kp DOT    &kp COMMA  &kp RSHFT
&kp ESC    &kp TAB   &kp BSPC  &kp DEL      &kp EQUAL                   &trans  &trans  &kp ESC  &kp N0  &kp ENTER  &kp SPACE                        &kp N0    &kp DOT   &kp PLUS  &kp MINUS  &kp ENTER
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 4: FUN — IDE power tools + debug (hold Enter)
        //
        //   Row 1: F1-F5 | F6-F11
        //   Row 2: Terminal | Find | Git | GoDef | Refind | F18-F22 | F12
        //   Row 3: Save | Find-in-file | Print | Quick-fix | Close-tab | Rename | F11 | Lock
        //   Row 4: Undo | Cut | Copy | Paste | Redo | Prev/Play/Next/Vol-/Vol+
        //   Row 5: Screenshot-3 | Screenshot-4 | Screenshot-5 | Lock | Home/End/PgUp/PgDn
        //   Debug keys on right-hand F-row: F5(cont) F9(bp) F10(over) F11(into) Shift+F5(stop)
        // ═══════════════════════════════════════════════════════════════
        layer_fun {
            display-name = "FUN";
            bindings = <
// Row 1
&kp ESC    &kp F1    &kp F2    &kp F3     &kp F4     &kp F5     &none                                &none        &kp F6        &kp F7  &kp F8  &kp F9     &kp F10    &kp F11
// Row 2 — macros + debug
&kp TAB    &term     &findf    &gitp      &godef     &frefs     &none                                &none        &dbgc         &dbgb   &dbgo   &dbgi      &dbgs      &kp F12
// Row 3 — IDE actions
&kp ESC    &kp LG(S) &kp LG(F) &kp LG(LS(P)) &kp LG(P)  &renam   &kp LGUI &kp LCTRL &kp LALT &kp RALT &kp RCTRL &kp RGUI  &kp LG(LBKT) &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(RBKT) &qfix     &kp LC(LG(Q))
// Row 4 — clipboard + media
&kp LSHFT  &kp LG(Z) &kp LG(X) &kp LG(C)  &kp LG(V)  &kp LG(LS(Z))               &trans          &trans                                   &kp C_PREV   &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &kp RSHFT
// Row 5 — screenshots + nav
&kp GRAVE  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LC(LG(Q)) &kp BSPC &kp DEL &kp ESC &kp TAB &trans  &kp SPACE                        &kp HOME     &kp END  &kp PG_UP &kp PG_DN    &mo SYS
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 5: SYS — Bluetooth, RGB, backlight, media, firmware
        // ═══════════════════════════════════════════════════════════════
        layer_sys {
            display-name = "SYS";
            bindings = <
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans                          &trans      &studio_unlock  &none          &none          &none          &none          &none
&none      &none        &none        &none        &none        &none        &none                           &none       &none           &none          &none          &none          &none          &none
&none      &none        &none        &none        &none        &none        &none &none &none &none &none &none &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI
&none      &none        &none        &none        &none        &none                           &kp C_BRI_DN    &kp C_BRI_UP                                   &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
&none      &none        &none        &none        &none                      &none  &none  &none  &none  &none  &none                          &bl BL_INC  &bl BL_DEC   &bl BL_TOG  &kp LC(LG(Q)) &trans
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 6: APP — Window manager (hold left inner-thumb Esc)
        //   Ctrl+Alt+Gui+<key> → bind in Hammerspoon / Karabiner / AeroSpace
        // ═══════════════════════════════════════════════════════════════
        layer_app {
            display-name = "APP";
            bindings = <
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(N1))) &kp LC(LA(LG(N2))) &kp LC(LA(LG(N3))) &kp LC(LA(LG(N4))) &kp LC(LA(LG(N5))) &none                   &none                 &kp LC(LA(LG(N6))) &kp LC(LA(LG(N7))) &kp LC(LA(LG(N8))) &kp LC(LA(LG(N9))) &kp LC(LA(LG(N0))) &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))   &kp LC(LA(LG(Q)))  &kp LC(LA(LG(W)))  &kp LC(LA(LG(E)))  &kp LC(LA(LG(R)))  &kp LC(LA(LG(T)))  &none                   &none                 &kp LC(LA(LG(Y)))  &kp LC(LA(LG(U)))  &kp LC(LA(LG(I)))  &kp LC(LA(LG(O)))  &kp LC(LA(LG(P)))  &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))   &kp LC(LA(LG(A)))  &kp LC(LA(LG(S)))  &kp LC(LA(LG(D)))  &kp LC(LA(LG(F)))  &kp LC(LA(LG(G)))  &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &kp F18  &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI))) &kp LC(LA(LG(SQT)))
&kp LSHFT             &kp LC(LA(LG(Z)))  &kp LC(LA(LG(X)))  &kp LC(LA(LG(C)))  &kp LC(LA(LG(V)))  &kp LC(LA(LG(B)))                &trans       &kp F19                                  &kp LC(LA(LG(N))) &kp LC(LA(LG(M))) &kp LC(LA(LG(COMMA))) &kp LC(LA(LG(DOT))) &kp LC(LA(LG(FSLH))) &kp RSHFT
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(LBKT))) &kp LC(LA(LG(RBKT))) &kp LC(LA(LG(LPAR))) &kp LC(LA(LG(RPAR)))   &kp F20 &kp F21 &kp F22 &kp F23 &kp F24 &kp LC(LA(LG(SPACE)))  &kp LC(LA(LG(LEFT))) &kp LC(LA(LG(DOWN))) &kp LC(LA(LG(UP))) &kp LC(LA(LG(RIGHT))) &trans
            >;
        };
    };
};
