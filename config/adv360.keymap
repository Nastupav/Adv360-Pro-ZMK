/*
 * ZMK keymap for Kinesis Advantage360 Pro
 *
 * Layers:
 * 0 BASE (QWERTY + HRM, Shift moved to thumb: tap End / hold Shift)
 * 1 SYM  (hold BSPC/DEL)
 * 2 NAV  (hold SPACE)
 * 3 MOD  (BT/RGB/boot)
 * 4 WM1  (hold ENTER)  -> workspaces 1-10 + window/workspace navigation
 * 5 WM2  (WM bank)     -> workspaces 11-20 on SAME top row keys
 *
 * WM UX:
 * - Hold ENTER = WM1
 * - While holding ENTER, hold Thumb-Shift (tap End / hold Shift on base)
 *   to momentarily access WM2 (bank to workspaces 11-20)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Home Row Mods (your existing style, reliable)
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // WM Hold-Tap:
        // Tap = focus/action, Hold = move/action (usually "move window + follow")
        wmh: wm_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "WM_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // ---------- Pairing macros (programming) ----------
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_PAREN";
            bindings =
                <&macro_tap &kp LPAR>,
                <&macro_tap &kp RPAR>,
                <&macro_tap &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_BRACE";
            bindings =
                <&macro_tap &kp LBRC>,
                <&macro_tap &kp RBRC>,
                <&macro_tap &kp LEFT>;
        };

        pair_bracket: pair_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_BRACKET";
            bindings =
                <&macro_tap &kp LBKT>,
                <&macro_tap &kp RBKT>,
                <&macro_tap &kp LEFT>;
        };

        pair_dq: pair_dq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_DQUOTE";
            bindings =
                <&macro_tap &kp DOUBLE_QUOTES>,
                <&macro_tap &kp DOUBLE_QUOTES>,
                <&macro_tap &kp LEFT>;
        };

        pair_sq: pair_sq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "PAIR_SQUOTE";
            bindings =
                <&macro_tap &kp SQT>,
                <&macro_tap &kp SQT>,
                <&macro_tap &kp LEFT>;
        };

        // Your existing AFN macro (kept)
        afn: afn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "AFN";
            bindings = <
                &none
                &macro_tap &kp LPAR  &macro_tap &kp SPACE &macro_tap &kp RPAR &macro_tap &kp SPACE
                &macro_tap &kp LS(S) &macro_tap &kp P &macro_tap &kp A &macro_tap &kp C &macro_tap &kp E
                &macro_tap &kp SPACE &macro_tap &kp EQUAL &macro_tap &kp SPACE &macro_tap &kp GT &macro_tap &kp SPACE
                &macro_tap &kp LS(S) &macro_tap &kp P &macro_tap &kp A &macro_tap &kp C &macro_tap &kp E
                &macro_tap &kp SPACE &macro_tap &kp LBRC &macro_tap &kp SPACE &macro_tap &kp RBRC &macro_tap &kp SPACE
                &macro_tap &kp LS(L) &macro_tap &kp E &macro_tap &kp F &macro_tap &kp T
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0: BASE (QWERTY + HRM)
        // - Shift moved to left thumb "End" position: tap End / hold Shift
        // =========================================================
        default_layer {
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4            &kp N5  &none                                                      &mo 3        &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R             &kp T   &trans                                                    &trans       &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &trans     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans      &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V             &kp B                          &kp HOME      &kp PG_UP                          &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                 &lt 1 BSPC  &lt 1 DEL  &mt LSHFT END &kp PG_DN  &lt 4 ENTER  &lt 2 SPACE          &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 2
            >;
        };

        // =========================================================
        // LAYER 1: SYM (hold BSPC/DEL)
        // =========================================================
        layer_sym {
            bindings = <
&trans  &kp F1      &kp F2       &kp F3       &kp F4        &kp F5     &afn                                           &none  &kp F6    &kp F7     &kp F8     &kp F9     &kp F10          &kp F11
&trans  &kp EXCL    &kp AT       &kp HASH     &kp DLLR      &kp PRCNT  &none                                          &none  &kp CARET &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR         &kp F12
&trans  &kp LBRC    &kp RBRC     &kp LBKT     &kp RBKT      &kp PIPE   &pair_brace   &pair_bracket &pair_paren &pair_dq &pair_sq   &none  &kp UNDER &kp MINUS &kp PLUS  &kp EQUAL &kp COLON &kp SEMI &trans
&trans  &kp LT      &kp GT       &kp BSLH     &kp GRAVE     &kp TILDE                 &trans        &trans                 &trans  &kp QMARK &kp SQT    &kp COMMA &kp DOT    &kp FSLH &trans
&trans  &trans      &trans       &trans       &trans                 &trans    &trans    &trans       &trans     &trans   &trans                &trans    &trans    &trans    &trans    &trans   &trans
            >;
        };

        // =========================================================
        // LAYER 2: NAV (hold SPACE)
        // =========================================================
        layer_nav {
            bindings = <
&trans  &trans        &trans         &trans          &trans         &trans  &none                                     &none  &trans        &trans          &trans           &trans            &trans      &trans
&trans  &kp LC(T)     &kp LC(W)      &kp LC(R)       &kp LC(L)      &trans  &none                                     &none  &kp LC(TAB)   &kp LC(LS(TAB)) &kp HOME         &kp PG_UP         &kp PG_DN    &kp END
&trans  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(BSPC)    &kp LC(DEL)    &trans  &none   &trans  &trans   &trans  &trans  &none  &none         &kp LEFT         &kp DOWN         &kp UP       &kp RIGHT  &trans
&trans  &trans        &trans         &trans          &trans         &trans                  &trans       &trans                  &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans        &trans         &trans          &trans                &trans  &trans  &trans     &trans  &trans  &trans            &trans   &trans   &trans   &trans    &trans  &trans
            >;
        };

        // =========================================================
        // LAYER 3: MOD (BT/RGB/boot)
        // =========================================================
        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans                  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                       &bootloader             &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_MEFS_CMD 5  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                             &none      &none                                      &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                          &none  &none  &none  &none  &none
            >;
        };

        // =========================================================
        // LAYER 4: WM1 (hold ENTER)
        //
        // Core idea:
        // - Tap = focus (workspace/window)
        // - Hold = move (window) + follow (when bound in Glaze)
        //
        // Workspaces 1..10 live on the SAME top row keys:
        //   Q W E R T  => WS 1..5   (tap focus / hold move+follow)
        //   Y U I O P  => WS 6..10  (tap focus / hold move+follow)
        //
        // Bank to WM2 (workspaces 11..20):
        // - While holding ENTER, hold the Thumb-Shift key (the End/Shift key in base)
        //   to momentarily switch to layer 5 (WM2).
        //
        // J K L ;  => focus window left/down/up/right (tap)
        //            move window left/down/up/right (hold)
        //
        // N M , .  => focus workspace-in-direction down/up/right/left (tap)
        //            move window to workspace-in-direction + follow (hold)
        //
        // A / S    => prev/next active workspace on current monitor
        // D / F    => move window to prev/next active workspace on current monitor + follow
        // G        => recent workspace (tap) / move window to recent + follow (hold)
        //
        // Inner thumb buttons:
        // F13 toggle tiling direction, F14 toggle floating
        // Left inner row3: close, Right inner row3: reload
        // =========================================================
        layer_wm1 {
            bindings = <
&trans  &trans   &trans   &trans   &trans   &trans  &none                                                &none           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &wmh LC(LS(F13)) LC(F13)   &wmh LC(LS(F14)) LC(F14)   &wmh LC(LS(F15)) LC(F15)   &wmh LC(LS(F16)) LC(F16)   &wmh LC(LS(F17)) LC(F17)   &kp F13   &kp F14   &wmh LC(LS(F18)) LC(F18)   &wmh LC(LS(F19)) LC(F19)   &wmh LC(LS(F20)) LC(F20)   &wmh LC(LS(F21)) LC(F21)   &wmh LC(LS(F22)) LC(F22)   &trans
&trans  &kp F23  &kp LS(F23)  &kp LC(F23)  &kp LC(LS(F23))  &wmh LA(LS(F23)) LA(F23)   &kp F24  &kp LC(F24)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &wmh LS(F19) F19  &wmh LS(F20) F20  &wmh LS(F21) F21  &wmh LS(F22) F22  &trans
&trans  &kp LA(F24)  &kp LC(LA(F24))  &kp LA(F15)  &kp LA(F13)  &kp LA(F14)                 &trans        &trans                 &wmh LS(F18) F18  &wmh LS(F17) F17  &wmh LS(F16) F16  &wmh LS(F15) F15  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &mo 5     &trans      &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // =========================================================
        // LAYER 5: WM2 (bank) - workspaces 11..20 on SAME keys
        //
        // Tap = focus ws11..20, Hold = move window+follow to ws11..20
        // =========================================================
        layer_wm2 {
            bindings = <
&trans  &trans   &trans   &trans   &trans   &trans  &none                                                &none           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &wmh LC(LA(LS(F13))) LC(LA(F13))   &wmh LC(LA(LS(F14))) LC(LA(F14))   &wmh LC(LA(LS(F15))) LC(LA(F15))   &wmh LC(LA(LS(F16))) LC(LA(F16))   &wmh LC(LA(LS(F17))) LC(LA(F17))   &trans   &trans   &wmh LC(LA(LS(F18))) LC(LA(F18))   &wmh LC(LA(LS(F19))) LC(LA(F19))   &wmh LC(LA(LS(F20))) LC(LA(F20))   &wmh LC(LA(LS(F21))) LC(LA(F21))   &wmh LC(LA(LS(F22))) LC(LA(F22))   &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                 &trans        &trans                 &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans   &trans      &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
