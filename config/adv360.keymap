/*
 * Kinesis Advantage360 Pro / ZMK
 * Deterministic, cross-platform developer keymap.
 *
 * Design constraints:
 * - US QWERTY; no dual-role letters and no typing-layer combos.
 * - Dedicated thumb keys for NAV, SYM, NUM, and GLOBAL.
 * - Plain modifiers remain composable on every layer.
 * - F13-F20 form a host-neutral desktop control protocol.
 * - Destructive actions are available only as SYS-layer combos.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define NAV    1
#define SYM    2
#define NUM    3
#define GLOBAL 4
#define SYS    5

/ {
    combos {
        compatible = "zmk,combos";

        // Deliberate, SYS-only chords. No combo affects normal typing.
        combo_bt_clear {
            timeout-ms = <150>;
            key-positions = <1 2>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };

        combo_bootloader {
            timeout-ms = <250>;
            key-positions = <20 21>;
            layers = <SYS>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE
         *
         *  =  1 2 3 4 5  SYS | SYS  6 7 8 9 0 -
         * Tab Q W E R T   Caps|Repeat Y U I O P \
         * Esc A S D F G  A C G|G C A H J K L ; '
         * Shf Z X C V B    NAV|SYM   N M , . / Shf
         *  `  [ ] ( )   Bsp Del NUM|GLOBAL Ent Spc  Left Down Up Right SYS
         *
         * Upper thumbs are mirrored Alt/Ctrl/GUI, with GUI nearest center.
         */
        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &mo SYS                         &mo SYS &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &caps_word                      &key_repeat &kp Y &kp U &kp I &kp O &kp P &kp BSLH
&kp ESC   &kp A  &kp S  &kp D  &kp F  &kp G  &kp LALT &kp LCTRL &kp LGUI    &kp RGUI &kp RCTRL &kp RALT &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B              &mo NAV             &mo SYM              &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
&kp GRAVE &kp LBKT &kp RBKT &kp LPAR &kp RPAR       &kp BSPC &kp DEL &mo NUM &mo GLOBAL &kp ENTER &kp SPACE       &kp LEFT &kp DOWN &kp UP &kp RIGHT &mo SYS
            >;
        };

        /* NAV: hold the left middle thumb; use Vim-shaped H/J/K/L. */
        layer_nav {
            display-name = "NAV";
            bindings = <
&kp ESC &none &none &none &none &none &trans                                 &trans &none &none &none &none &none &none
&kp TAB &none &none &none &none &none &caps_word                             &key_repeat &kp HOME &kp PG_UP &kp PG_DN &kp END &kp BSPC &kp DEL
&kp ESC &none &none &none &none &none &trans &trans &trans                   &trans &trans &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp HOME &kp END
&trans  &none &none &none &none &none              &trans                    &trans                 &kp HOME &kp PG_DN &kp PG_UP &kp END &kp DEL &trans
&none &none &none &none &none       &trans &trans &trans &trans &trans &trans       &kp HOME &kp PG_DN &kp PG_UP &kp END &trans
            >;
        };

        /*
         * SYM: paired and mnemonic.
         * Home row:  < { [ ( =  |  + ) ] } > -
         * Top row preserves the familiar US shifted-number symbols.
         */
        layer_sym {
            display-name = "SYM";
            bindings = <
&kp PLUS &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &trans                   &trans &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER
&kp TAB &kp GRAVE &kp TILDE &kp BSLH &kp PIPE &kp COLON &trans               &trans &kp SEMI &kp SQT &kp DQT &kp FSLH &kp QMARK &kp BSLH
&kp ESC &kp LT &kp LBRC &kp LBKT &kp LPAR &kp EQUAL &trans &trans &trans     &trans &trans &trans &kp PLUS &kp RPAR &kp RBKT &kp RBRC &kp GT &kp MINUS
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT           &trans          &trans             &kp CARET &kp AMPS &kp ASTRK &kp COLON &kp QMARK &trans
&kp GRAVE &kp BSLH &kp PIPE &kp LT &kp GT       &trans &trans &trans &trans &trans &trans       &kp PLUS &kp MINUS &kp EQUAL &kp UNDER &kp FSLH
            >;
        };

        /* NUM: left-hand F keys and a standard right-hand numpad. */
        layer_num {
            display-name = "NUM";
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &trans                             &trans &none &none &none &none &none &none
&kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans                         &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_DIVIDE &kp KP_MULTIPLY &kp BSPC
&kp ESC &none &none &none &none &none &trans &trans &trans                   &trans &trans &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS &kp KP_PLUS &kp KP_ENTER
&trans &none &none &none &none &none               &trans                    &trans                &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_DOT &kp COMMA &trans
&none &none &none &none &none       &trans &trans &trans &trans &trans &trans       &kp KP_N0 &kp KP_DOT &kp KP_PLUS &kp KP_MINUS &kp KP_ENTER
            >;
        };

        /*
         * GLOBAL protocol:
         *   1..8        -> F13..F20         (workspace)
         *   Shift+1..8  -> Shift+F13..F20   (move to workspace)
         *   H/J/K/L     -> Ctrl+F13..F16    (focus direction)
         *   Shift+HJKL  -> Ctrl+Shift+F13..F16 (move direction)
         *   [ / ]       -> Ctrl+F17/F18     (previous/next workspace)
         *   F / R       -> Ctrl+F19/F20     (fullscreen/float)
         *   Q / P       -> Ctrl+Shift+F19/F20 (close/split)
         *   Enter/T/B/E/Space/V/G -> Alt+F13..F19 (core applications)
         */
        layer_global {
            display-name = "GLOBAL";
            bindings = <
&none &kp F13 &kp F14 &kp F15 &kp F16 &kp F17 &trans                         &trans &kp F18 &kp F19 &kp F20 &none &none &none
&none &kp LC(LS(F19)) &none &kp LA(F16) &kp LC(F20) &kp LA(F14) &trans       &trans &none &none &none &none &kp LC(LS(F20)) &none
&none &none &none &none &kp LC(F19) &kp LA(F19) &trans &trans &trans         &trans &trans &trans &kp LC(F13) &kp LC(F14) &kp LC(F15) &kp LC(F16) &none &none
&trans &none &none &none &kp LA(F18) &kp LA(F15)             &trans          &trans             &none &none &none &none &none &trans
&none &kp LC(F17) &kp LC(F18) &none &none       &trans &trans &trans &trans &kp LA(F13) &kp LA(F17)       &none &none &none &none &trans
            >;
        };

        /* SYS: connectivity, indicators, media, and protected maintenance. */
        layer_sys {
            display-name = "SYS";
            bindings = <
&out OUT_USB &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans   &trans &out OUT_BLE &out OUT_TOG &none &none &none &none
&none &none &none &none &none &none &none                                             &none &none &none &none &none &none &none
&none &none &none &none &none &none &trans &trans &trans                              &trans &trans &trans &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI
&trans &none &none &none &none &none                         &trans                    &trans                &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &kp C_VOL_UP &trans
&none &none &none &none &none       &out OUT_USB &out OUT_BLE &out OUT_TOG &bl BL_TOG &bl BL_DEC &bl BL_INC       &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &kp C_MUTE &trans
            >;
        };
    };
};
