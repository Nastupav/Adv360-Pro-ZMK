/*
 * ZMK keymap for Kinesis Advantage360 Pro
 *
 * Layer model:
 *   0 BASE     typing + home-row mods
 *   1 NAV      movement, selection, tabs, edit actions
 *   2 SYM      coding symbols and delimiters
 *   3 NUM      numpad + function keys
 *   4 WM       GlazeWM control surface
 *   5 APPSYS   app launch + keyboard system controls
 *
 * Thumb model:
 *   BSPC hold -> SYM
 *   DEL  hold -> NUM
 *   ESC  hold -> APPSYS
 *   ENTER hold -> WM
 *   SPACE hold -> NAV
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <195>;
            quick-tap-ms = <145>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        th: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1       &kp N2       &kp N3       &kp N4       &kp N5    &kp F11                                                        &kp F12      &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS
&kp ESC    &kp Q        &kp W        &kp E        &kp R        &kp T     &kp PRINTSCREEN                                                &kp K_CONTEXT_MENU  &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSLH
&kp TAB    &hm LGUI A   &hm LALT S   &hm LCTRL D  &hm LSHFT F  &kp G     &kp K_UNDO   &kp K_CUT    &kp K_COPY    &kp K_PASTE  &kp K_REDO   &kp INSERT   &kp H        &hm RSHFT J  &hm RCTRL K  &hm RALT L   &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C        &kp V        &kp B                               &th 5 ESC      &kp PG_UP                               &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
&kp GRAVE  &kp LBKT     &kp RBKT     &kp LEFT     &kp RIGHT              &th 2 BSPC    &th 3 DEL    &kp TAB      &kp PG_DN    &th 4 ENTER   &th 1 SPACE              &kp UP       &kp DOWN     &kp LBRC     &kp RBRC     &kp PIPE
            >;
        };

        layer_nav {
            bindings = <
&trans  &trans           &trans              &trans             &trans              &trans             &trans                                                     &trans             &trans         &trans         &trans         &trans         &trans         &trans
&trans  &kp K_FIND       &kp LC(LS(TAB))     &kp LC(TAB)        &kp K_UNDO          &kp K_REDO         &trans                                                     &trans             &kp LA(LEFT)   &kp LC(PG_UP)  &kp LC(PG_DN)  &kp LA(RIGHT)  &kp DEL        &trans
&trans  &kp HOME         &kp LC(LEFT)        &kp LC(RIGHT)      &kp END             &kp LC(HOME)       &kp K_UNDO   &kp K_CUT    &kp K_COPY    &kp K_PASTE  &kp K_REDO   &kp INSERT   &kp LC(END)   &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &trans
&trans  &kp LS(HOME)     &kp LC(LS(LEFT))    &kp LC(LS(RIGHT))  &kp LS(END)         &kp LC(LS(HOME))                        &trans       &trans                                &kp LC(LS(END))  &kp LS(LEFT)  &kp LS(DOWN)  &kp LS(UP)     &kp LS(RIGHT)  &trans
&trans  &trans           &trans              &trans             &trans                        &kp DEL         &kp BSPC     &kp TAB      &kp ENTER    &trans        &trans                    &kp PG_UP     &kp PG_DN     &trans        &trans        &trans
            >;
        };

        layer_sym {
            bindings = <
&trans  &kp F1       &kp F2       &kp F3      &kp F4      &kp F5      &trans                                                        &trans        &kp F6       &kp F7      &kp F8      &kp F9      &kp F10      &kp F11
&trans  &kp EXCL     &kp AT       &kp HASH    &kp DLLR    &kp PRCNT   &trans                                                        &trans        &kp CARET    &kp AMPS    &kp STAR    &kp QMARK   &kp TILDE    &kp F12
&trans  &kp LPAR     &kp LBKT     &kp LBRC    &kp LT      &kp GRAVE   &kp UNDER   &kp PLUS   &kp COLON   &kp SEMI    &kp MINUS   &kp EQUAL   &kp GT       &kp RBRC    &kp RBKT    &kp RPAR    &kp PIPE      &kp BSLH
&trans  &kp UNDER    &kp MINUS    &kp EQUAL   &kp PLUS    &kp QMARK                          &kp TAB        &kp LS(TAB)                           &kp SQT      &kp FSLH    &kp BSLH    &kp COLON   &kp SEMI     &trans
&trans  &trans       &trans       &trans      &trans                &trans         &trans       &trans       &kp TAB     &kp LS(TAB)   &trans                    &trans       &trans       &trans       &trans       &trans
            >;
        };

        layer_num {
            bindings = <
&trans  &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                                                         &kp F7        &kp F8       &kp F9       &kp F10      &kp F11      &kp F12      &trans
&trans  &trans       &trans       &trans       &trans       &trans       &trans                                                         &trans        &kp N7       &kp N8       &kp N9       &kp KP_MINUS &kp KP_MULTIPLY &kp KP_SLASH
&trans  &kp KP_MINUS &kp KP_PLUS  &kp KP_MULTIPLY &kp KP_SLASH &kp EQUAL &trans      &trans     &trans      &trans      &trans      &trans       &trans        &kp N4       &kp N5       &kp N6       &kp KP_PLUS  &kp ENTER
&trans  &trans       &trans       &trans       &trans       &trans                             &trans         &trans                                &kp N1       &kp N2       &kp N3       &kp N0       &kp DOT      &kp ENTER
&trans  &trans       &trans       &trans       &trans                 &kp BSPC      &kp DEL     &kp TAB      &trans      &trans        &kp SPACE                 &trans       &trans       &trans       &trans       &trans
            >;
        };

        layer_wm {
            bindings = <
&trans  &kp LC(F13)      &kp LC(F14)      &kp LC(F15)      &kp LC(F16)      &kp LC(F17)      &kp LG(LS(F13))                                           &kp LG(LS(F14))  &kp LC(F18)      &kp LC(F19)      &kp LC(F20)      &kp LC(F10)      &kp LC(F12)      &kp LG(LS(F15))
&trans  &kp LC(LS(F13))  &kp LC(LS(F14))  &kp LC(LS(F15))  &kp LC(LS(F16))  &kp LC(LS(F17))  &kp LG(F13)                                               &kp LG(F17)      &kp LC(LS(F18))  &kp LC(LS(F19))  &kp LC(LS(F20))  &kp LC(LS(F10))  &kp LC(LS(F12))  &trans
&trans  &kp LC(LA(LG(A))) &kp LC(LA(LG(S))) &kp LC(LA(LG(D))) &kp LC(LA(LG(F))) &trans        &kp LG(F18)  &kp LG(F19)  &kp LG(F20)  &kp LG(F10)  &trans       &trans        &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI))) &trans
&trans  &kp LC(LA(LS(LG(A)))) &kp LC(LA(LS(LG(S)))) &kp LC(LA(LS(LG(D)))) &kp LC(LA(LS(LG(F)))) &trans        &trans        &trans                                &kp LC(LA(LS(LG(H)))) &kp LC(LA(LS(LG(J)))) &kp LC(LA(LS(LG(K)))) &kp LC(LA(LS(LG(L)))) &kp LC(LA(LS(LG(SEMI)))) &trans
&kp LG(LA(F13))  &kp LG(LA(F14))  &kp LG(LA(F15))  &kp LG(LA(F16))  &kp LG(LA(F17))         &kp F24       &kp LS(F24)  &kp LG(F24)  &kp LC(F24)  &kp LA(F24)   &kp LG(LA(F18))         &kp LG(LA(F19))  &kp LG(LA(F20))  &kp LG(LA(F10))  &kp LG(LA(F12))  &trans
            >;
        };

        layer_appsys {
            bindings = <
&none  &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4      &bt BT_CLR                                               &bootloader      &kp C_AL_KEYBOARD_LAYOUT  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &bl BL_INC      &bl BL_DEC
&none  &kp LC(LA(LG(Q))) &kp LC(LA(LG(W))) &kp LC(LA(LG(E))) &kp LC(LA(LG(R))) &kp LC(LA(LG(T))) &none                                                    &none            &kp LC(LA(LG(Y)))        &kp LC(LA(LG(U))) &kp LC(LA(LG(I))) &kp LC(LA(LG(O))) &kp LC(LA(LG(P))) &none
&none  &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4      &bt BT_CLR   &bootloader &kp C_AL_KEYBOARD_LAYOUT &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &bl BL_ON       &bl BL_INC      &bl BL_DEC      &bl BL_CYCLE    &rgb_ug RGB_EFF  &rgb_ug RGB_EFR
&none  &kp LC(LA(LG(Z))) &kp LC(LA(LG(X))) &kp LC(LA(LG(C))) &kp LC(LA(LG(V))) &kp LC(LA(LG(B)))                      &none            &none                                 &kp LC(LA(LG(N))) &kp LC(LA(LG(M))) &kp LC(LA(LG(COMMA))) &kp LC(LA(LG(DOT))) &kp LC(LA(LG(FSLH))) &kp LC(LA(LG(MINUS)))
&none  &none             &none             &none             &none                       &none         &none        &none         &none        &none          &none                      &none             &none             &kp LC(LA(LG(PIPE))) &kp LC(LA(LG(QMARK))) &none
            >;
        };
    };
};
