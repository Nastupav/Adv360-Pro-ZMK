/*
 * ZMK keymap for Kinesis Advantage360 Pro
 * Layers:
 * 0 BASE (QWERTY + HRM; thumb: tap End / hold Shift)
 * 1 SYM  (hold BSPC/DEL)
 * 2 NAV  (hold SPACE)
 * 3 MOD  (BT/RGB/boot)
 * 4 WM   (hold ENTER) -> focus with Enter+key; move requires Shift
 * 5 NUMPAD (momentary from base top row)
 * 6 APP  (hold ESC thumb key) -> Ctrl+Alt+Win+<key> for quicklaunch/system binds
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        app: app_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "APP_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0: BASE
        // =========================================================

        default_layer {
            bindings = <
&kp EQUAL  &kp N1                &kp N2                 &kp N3       &kp N4       &kp N5  &mo 5                                                                            &mo 3               &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q                 &kp W                  &kp E        &kp R        &kp T   &kp PRINTSCREEN                                                                  &kp K_CONTEXT_MENU  &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A            &hm LALT S             &hm LCTRL D  &hm LSHFT F  &kp G   &kp LC(PRINTSCREEN)  &kp LCTRL  &kp LEFT_ALT       &kp RCTRL  &kp RIGHT_COMMAND  &mt LC(V) LC(C)     &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z                 &kp X                  &kp C        &kp V        &kp B                                   &app 6 ESC         &kp PG_UP                                         &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT     &kp RIGHT            &lt 1 BSPC           &lt 5 DEL  &mt LSHFT END      &kp K_APP  &lt 4 ENTER        &lt 2 SPACE                 &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 2
            >;
        };

        // =========================================================
        // LAYER 1: SYM
        // =========================================================

        layer_sym {
            bindings = <
&kp GRAVE  &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                                                &kp CARET  &kp AMPS  &kp STAR   &kp PIPE   &kp BSLH   &kp FSLH   &kp QMARK
&kp TAB    &kp EQUAL  &kp PLUS   &kp MINUS  &kp UNDER  &kp COLON  &kp SEMI                                                 &kp COMMA  &kp DOT   &kp BSLH   &kp FSLH   &kp QMARK  &kp LT     &kp GT
&kp ESC    &kp LPAR   &kp LBKT   &kp LBRC   &kp LT     &kp SQT    &kp GRAVE  &kp TILDE  &kp DQT        &kp GT    &kp RBRC  &kp RBKT   &kp RPAR  &kp PIPE   &kp BSLH   &kp FSLH   &kp QMARK  &kp SEMI
&kp BSLH   &kp GRAVE  &kp TILDE  &kp UNDER  &kp MINUS  &kp PLUS                         &kp EQUAL      &kp AMPS                       &kp STAR  &kp COMMA  &kp DOT    &kp FSLH   &kp PIPE   &kp QMARK
&kp SQT    &kp DQT    &kp LPAR   &kp RPAR   &kp LBKT              &kp RBKT   &kp LBRC   &kp RBRC       &kp BSLH  &kp FSLH  &kp UNDER            &kp MINUS  &kp EQUAL  &kp COLON  &kp SEMI   &kp PIPE
            >;
        };

        // =========================================================
        // LAYER 2: NAV
        // =========================================================

        layer_nav {
            bindings = <
&kp LA(LEFT)  &kp LA(RIGHT)     &kp LS(F3)              &kp F3                &kp LC(PG_UP)      &kp LC(PAGE_DOWN)  &kp LC(HOME)                                                            &kp LC(END)    &kp LC(LS(HOME))  &kp LC(LS(END))  &kp LS(HOME)        &kp LS(END)       &kp PG_UP      &kp PAGE_DOWN
&kp TAB       &kp LC(Z)         &kp LC(Y)               &kp LC(X)             &kp LC(C)          &kp LC(V)          &kp PG_UP                                                               &kp PAGE_DOWN  &kp LC(A)         &kp LC(F)        &kp LC(LS(TAB))     &kp LC(TAB)       &kp HOME       &kp END
&kp ESC       &kp LC(LEFT)      &kp LC(RIGHT)           &kp LC(BSPC)          &kp LC(DEL)        &kp BSPC           &kp LCTRL     &trans   &trans             &trans             &trans     &kp TAB        &kp DEL           &kp LEFT         &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT      &kp ENTER
&kp LSHFT     &kp LC(LS(LEFT))  &kp LC(LS(DOWN_ARROW))  &kp LC(LS(UP_ARROW))  &kp LC(LS(RIGHT))  &kp LC(LS(HOME))                          &kp LS(PG_UP)      &kp LS(PAGE_DOWN)                            &kp LC(LS(END))   &kp LS(LEFT)     &kp LS(DOWN_ARROW)  &kp LS(UP_ARROW)  &kp LS(RIGHT)  &kp RSHFT
&kp ESC       &kp TAB           &kp LC(Z)               &kp LC(Y)             &kp LC(F)                             &kp BSPC      &kp DEL  &kp LSHFT          &kp LC(A)          &kp ENTER  &kp SPACE                        &kp HOME         &kp END             &kp PG_UP         &kp PAGE_DOWN  &kp LA(LEFT)
            >;
        };

        // =========================================================
        // LAYER 3: MOD (BT/RGB/boot)
        // =========================================================

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans           &none            &none            &none            &none            &none            &none
&none  &none         &none         &none         &none         &none         &bootloader                                       &bootloader      &none            &none            &none            &none            &none            &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD
&none  &none         &none         &none         &none         &none                             &none      &none                               &none            &bl BL_ON        &bl BL_OFF       &bl BL_CYCLE     &none            &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                             &bl BL_INC       &bl BL_DEC       &none            &none            &none
            >;
        };

        // =========================================================
        // LAYER 4: WM
        // =========================================================

        layer_wm {
            bindings = <
&kp ESC    &kp LC(LG(F13))  &kp LC(LG(F14))  &kp LC(LG(F15))  &kp LC(LG(F16))  &kp LC(LG(F17))  &kp LA(F4)                                                                                  &kp LC(LG(F22))  &kp LC(LG(F18))  &kp LC(LG(F19))  &kp LC(LG(F20))  &kp LC(LG(F21))  &kp F13          &kp F15
&kp TAB    &kp LC(F13)      &kp LC(F14)      &kp LC(F15)      &kp LC(F16)      &kp LC(F17)      &kp F16                                                                                     &kp F17          &kp LC(F18)      &kp LC(F19)      &kp LC(F20)      &kp LC(F21)      &kp LC(F22)      &kp LA(F4)
&kp ESC    &kp F13          &kp F14          &kp F15          &kp F16          &kp F17          &kp LC(LG(F13))  &kp LC(LA(F24))     &kp LC(LG(F24))      &kp LC(LG(F16))  &kp LC(LG(F17))  &kp LA(F4)       &kp LC(LG(F18))  &kp F19          &kp F20          &kp F21          &kp F22          &kp LC(LG(F21))
&kp LSHFT  &kp LC(LA(F13))  &kp LC(LA(F14))  &kp LC(LA(F15))  &kp LC(LA(F16))  &kp LC(LA(F17))                                       &kp LC(LG(F23))      &kp LC(LG(F20))                                    &kp LC(LA(F18))  &kp LC(LA(F19))  &kp LC(LA(F20))  &kp LC(LA(F21))  &kp LC(LA(F22))  &kp RSHFT
&kp ESC    &kp F13          &kp F14          &kp F15          &kp F16                           &kp F24          &hm LEFT_SHIFT F23  &kp LC(F24)          &kp LC(LG(F14))  &kp LA(F4)       &kp F17                           &kp LC(LG(F18))  &kp LC(LG(F19))  &kp LC(LG(F20))  &kp LC(LG(F21))  &kp LC(LG(F22))
            >;
        };

        // =========================================================
        // LAYER 5: NUMPAD
        // =========================================================

        layer_numpad {
            bindings = <
&kp ESC   &kp TAB   &kp BSPC   &kp DEL        &kp LPAR   &kp RPAR   &kp LBKT                                                &kp RBKT    &kp SLASH  &kp ASTERISK  &kp MINUS     &kp PLUS       &kp EQUAL  &kp ENTER
&kp HOME  &kp END   &kp PG_UP  &kp PAGE_DOWN  &kp COMMA  &kp DOT    &kp TAB                                                 &kp BSPC    &kp EQUAL  &kp N7        &kp N8        &kp N9         &kp MINUS  &kp KP_PLUS
&kp ESC   &kp PLUS  &kp MINUS  &kp EQUAL      &kp UNDER  &kp PRCNT  &kp TAB   &kp BSPC  &kp DEL        &kp HOME  &kp END    &kp ENTER   &kp SLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6   &kp STAR   &kp KP_ENTER
&kp LBRC  &kp RBRC  &kp LT     &kp GT         &kp HASH   &kp DLLR                       &kp AMPS       &kp STAR                         &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp DOT    &kp BSPC
&kp ESC   &kp TAB   &kp BSPC   &kp DEL        &kp EQUAL             &kp LPAR  &kp RPAR  &kp ENTER      &kp HOME  &kp KP_N0  &kp KP_DOT             &kp END       &kp PG_UP     &kp PAGE_DOWN  &kp PLUS   &kp KP_ENTER
            >;
        };

        // =========================================================
        // LAYER 6: APP (USE ALL KEYS)
        // Hold the ESC thumb key to access.
        // Sends Ctrl+Alt+Win+<key> for every position (except CAPS itself which is held).
        // Bind these in GlazeWM to launch apps / scripts.
        // =========================================================

        layer_app {
            bindings = <
&kp LC(LS(EQUAL))  &kp LC(LS(N1))     &kp LC(LS(N2))  &kp LC(LS(N3))    &kp LC(LS(N4))     &kp LC(LS(N5))  &kp LC(LS(F1))                                                                                 &kp LC(LS(F2))     &kp LC(LS(N6))  &kp LC(LS(N7))  &kp LC(LS(N8))     &kp LC(LS(N9))    &kp LC(LS(N0))    &kp LC(LS(MINUS))
&kp LC(LS(TAB))    &kp LC(LS(Q))      &kp LC(LS(W))   &kp LC(LS(E))     &kp LC(LS(R))      &kp LC(LS(T))   &kp LC(LS(F3))                                                                                 &kp LC(LS(F4))     &kp LC(LS(Y))   &kp LC(LS(U))   &kp LC(LS(I))      &kp LC(LS(O))     &kp LC(LS(P))     &kp LC(LS(BSLH))
&kp LC(LS(ESC))    &kp LC(LS(A))      &kp LC(LS(S))   &kp LC(LS(D))     &kp LC(LS(F))      &kp LC(LS(G))   &kp LC(LS(F5))    &kp LC(LS(F6))   &kp LC(LS(F7))        &kp LC(LS(F8))     &kp LC(LS(F9))     &kp LC(LS(F10))    &kp LC(LS(H))   &kp LC(LS(J))   &kp LC(LS(K))      &kp LC(LS(L))     &kp LC(LS(SEMI))  &kp LC(LS(SQT))
&kp LC(LS(LSHFT))  &kp LC(LS(Z))      &kp LC(LS(X))   &kp LC(LS(C))     &kp LC(LS(V))      &kp LC(LS(B))                                      &kp LC(LS(HOME))      &kp LC(LS(PG_UP))                                        &kp LC(LS(N))   &kp LC(LS(M))   &kp LC(LS(COMMA))  &kp LC(LS(DOT))   &kp LC(LS(FSLH))  &kp LC(LS(RSHFT))
&kp LC(LS(GRAVE))  &kp LC(LS(GRAVE))  &trans          &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))                  &kp LC(LS(BSPC))  &kp LC(LS(DEL))  &kp LC(LS(END))       &kp LC(LS(PG_DN))  &kp LC(LS(ENTER))  &kp LC(LS(SPACE))                  &kp LC(LS(UP))  &kp LC(LS(DOWN))   &kp LC(LS(LBKT))  &kp LC(LS(RBKT))  &kp LC(LS(F11))
            >;
        };
    };
};
