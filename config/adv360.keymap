/*
 * Kinesis Advantage360 Pro / ZMK — Optimized SWE Keymap
 * macOS-primary, Windows secondary (mental Cmd↔Ctrl remap).
 *
 * Built on the existing positional-HRM foundation. Additions:
 *   v3.1 — require-prior-idle-ms + hold-trigger-on-release (ZMK 2025+)
 *   v3.2 — Caps Word for CONSTANTS / ENV_VARS / ClassNames
 *   v3.3 — Terminal / Find-in-files / Git macros bound to FUN layer
 *   v3.4 — lowered tapping-term (220→180ms), global-quick-tap for rollers
 *   v3.5 — bracket-pair combos: tap two adjacent keys → typed pair with cursor between
 *
 * NOTE: hold-trigger-key-positions intentionally REMOVED.
 * The Kinesis fork (refil/zmk adv360-z3.5-2) silently ignores this property
 * (GitHub issue #596). require-prior-idle-ms is the effective replacement.
 *
 * Layers: 0=BASE  1=NAV  2=SYM  3=NUM  4=FUN  5=SYS  6=APP
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/studio_unlock.dtsi>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define SYS  5
#define APP  6

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <120>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        term: term {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_tap &kp GRAVE>
                     , <&macro_release &kp LCTRL>;
        };

        findf: findf {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>
                     , <&macro_press &kp LSHFT>
                     , <&macro_tap &kp F>
                     , <&macro_release &kp LSHFT>
                     , <&macro_release &kp LGUI>;
        };

        gitp: gitp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>
                     , <&macro_press &kp LSHFT>
                     , <&macro_tap &kp G>
                     , <&macro_release &kp LSHFT>
                     , <&macro_release &kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_clear {
            timeout-ms = <120>;
            key-positions = <1 2>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };

        combo_bootloader {
            timeout-ms = <200>;
            key-positions = <20 21>;
            layers = <SYS>;
            bindings = <&bootloader>;
        };

        /*
         * Bracket-pair combos — press two adjacent home-row keys together
         * to type the pair with cursor placed between them.
         * Timeout is tight (30ms) to prevent accidental triggers during typing.
         *
         * Key positions are approximate — adjust to your physical matrix:
         *   ( ) = left/right paren positions on base layer
         *   [ ] = left/right bracket positions
         *   { } = left/right brace positions
         *   " " = quote positions on SYM layer
         */
        combo_parens {
            timeout-ms = <30>;
            key-positions = <37 38>;  // LPAR + RPAR adjacency
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
        combo_brackets {
            timeout-ms = <30>;
            key-positions = <35 36>;  // LBKT + RBKT adjacency
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
        };
        combo_braces {
            timeout-ms = <30>;
            key-positions = <43 44>;  // LBRC + RBRC adjacency
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ═══════════════════════════════════════════════════════════════
        // LAYER 0: BASE
        // QWERTY + positional HRMs. Caps Word replaces the old ESC
        // inner-thumb position (row 5, position 2 of the 3L-thumbs).
        // ═══════════════════════════════════════════════════════════════

        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5   &mo SYS                                                                    &mo SYS         &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T    &none                                                                        &none           &kp Y     &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp ESC    &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G  &kp LGUI      &kp LCTRL     &kp LALT      &kp RALT    &kp RCTRL  &kp RGUI      &kp H     &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B                                  &tlt APP ESC    &kp TAB                                               &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp GRAVE  &kp LBKT  &kp RBKT  &kp LPAR   &kp RPAR               &tlt SYM BSPC &tlt NUM DEL  &caps_word      &kp TAB      &tlt FUN ENTER &tlt NAV SPACE                  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &mo SYS
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 1: NAV  (hold right-thumb Space)
        // Arrows on thumb cluster + JKL; left hand = mac controls.
        // ═══════════════════════════════════════════════════════════════

        layer_nav {
            display-name = "NAV";
            bindings = <
&kp ESC    &kp LA(LEFT)     &kp LA(RIGHT)     &kp LG(LBKT)     &kp LG(RBKT)      &kp PSCRN      &none                                                                      &none          &kp LC(LS(TAB)) &kp LC(TAB)  &kp LG(TAB)     &kp LG(LS(TAB)) &kp PG_UP    &kp PG_DN
&kp TAB    &kp LG(Z)        &kp LG(LS(Z))     &kp LG(X)        &kp LG(C)         &kp LG(V)      &none                                                                      &none          &kp HOME        &kp PG_DN    &kp PG_UP       &kp END         &kp DEL      &kp BSPC
&kp ESC    &kp LC(A)        &kp LC(E)         &kp LC(U)        &kp LC(K)         &kp LC(W)      &kp LGUI      &kp LCTRL      &kp LALT       &kp RALT    &kp RCTRL    &kp RGUI       &kp HOME  &kp LEFT      &kp DOWN   &kp UP       &kp RIGHT     &kp ENTER
&kp LSHFT  &kp LG(S)        &kp LG(F)         &kp LC(R)        &kp LC(C)         &kp LC(D)                                     &trans         &trans                                              &kp LA(LEFT) &kp LA(RIGHT) &kp LA(LS(LEFT)) &kp LA(LS(RIGHT)) &kp LA(BSPC) &kp RSHFT
&kp ESC    &kp TAB          &kp LG(Z)         &kp LG(LS(Z))    &kp LC(L)                        &kp BSPC      &kp DEL        &kp LSHFT      &kp LCTRL    &kp ENTER     &trans                           &kp HOME    &kp END     &kp PG_UP  &kp PG_DN   &trans
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 2: SYM  (hold left-thumb Backspace)
        // Opening delimiters on left, closing on right — split-hand rhythm.
        // ═══════════════════════════════════════════════════════════════

        layer_sym {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &none                                                                       &none       &kp CARET  &kp AMPS  &kp ASTRK &kp FSLH  &kp PIPE  &kp TILDE
&kp TAB    &kp GRAVE &kp TILDE &kp PIPE  &kp BSLH  &kp DQT    &none                                                                       &none       &kp AMPS   &kp STAR  &kp MINUS &kp UNDER  &kp COLON  &kp SEMI
&kp ESC    &kp LPAR  &kp LBRC  &kp LBRC  &kp LT     &kp EQUAL  &kp EXCL      &kp AT        &kp HASH       &kp DLLR   &kp PRCNT  &kp CARET    &kp PLUS &kp GT     &kp RBRC  &kp RBKT   &kp RPAR   &kp DQT
&kp LSHFT  &kp SQT   &kp DQT   &kp COMMA &kp DOT    &kp QMARK                              &trans         &trans                                          &kp AMPS  &kp STAR  &kp MINUS &kp UNDER  &kp FSLH   &kp RSHFT
&kp GRAVE  &kp SQT   &kp DQT   &kp LPAR  &kp RPAR                        &trans       &kp DEL        &kp ESC        &kp TAB    &kp ENTER  &kp SPACE                         &kp UNDER &kp MINUS &kp EQUAL &kp COLON  &kp SEMI
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 3: NUM  (hold left-thumb Delete)
        // Right-hand numpad, left navigation + readline.
        // ═══════════════════════════════════════════════════════════════

        layer_num {
            display-name = "NUM";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3       &kp F4       &kp F5     &none                                                                       &none      &kp F6    &kp F7    &kp F8    &kp F9     &kp F10   &kp F11
&kp TAB    &kp HOME  &kp PG_DN &kp PG_UP    &kp END      &kp BSPC   &none                                                                       &none      &kp N7    &kp N8    &kp N9    &kp MINUS  &kp PLUS  &kp BSPC
&kp ESC    &kp LC(A) &kp LC(E) &kp LC(U)    &kp LC(K)    &kp LC(W)  &kp LGUI      &kp LCTRL     &kp LALT       &kp RALT  &kp RCTRL &kp RGUI     &kp N4  &kp N5    &kp N6    &kp STAR   &kp FSLH  &kp ENTER
&kp LSHFT  &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT    &kp DEL                                  &trans          &trans                                         &kp N1    &kp N2    &kp N3    &kp DOT    &kp COMMA  &kp RSHFT
&kp ESC    &kp TAB   &kp BSPC  &kp DEL      &kp EQUAL                           &trans       &trans        &kp ESC        &kp N0    &kp ENTER  &kp SPACE                        &kp N0    &kp DOT   &kp PLUS  &kp MINUS  &kp ENTER
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 4: FUN  (hold right-thumb Enter)
        // F1-24, IDE commands, screenshots, lock, media.
        //
        // NEW: Terminal (Ctrl+`), Find-in-files (Cmd+Shift+F),
        // Git panel (Ctrl+Shift+G) bound to left-hand top-row F13-F17 positions.
        // ═══════════════════════════════════════════════════════════════

        layer_fun {
            display-name = "FUN";
            bindings = <
&kp ESC    &kp F1       &kp F2       &kp F3        &kp F4        &kp F5        &none                                                                       &none        &kp F6           &kp F7         &kp F8        &kp F9        &kp F10       &kp F11
&kp TAB    &term        &findf       &gitp         &kp F16       &kp F17       &none                                                                       &none        &kp F18          &kp F19        &kp F20       &kp F21       &kp F22       &kp F12
&kp ESC    &kp LG(S)    &kp LG(F)    &kp LG(LS(P)) &kp LG(P)     &kp LG(W)     &kp LGUI      &kp LCTRL      &kp LALT       &kp RALT    &kp RCTRL   &kp RGUI       &kp LG(LBKT) &kp LC(LS(TAB)) &kp LC(TAB)  &kp LG(RBKT)   &kp F11     &kp LC(LG(Q))
&kp LSHFT  &kp LG(Z)    &kp LG(X)    &kp LG(C)     &kp LG(V)     &kp LG(LS(Z))                            &trans          &trans                                             &kp C_PREV   &kp C_PP      &kp C_NEXT   &kp C_VOL_DN  &kp C_VOL_UP &kp RSHFT
&kp GRAVE  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LC(LG(Q))                      &kp BSPC       &kp DEL        &kp ESC         &kp TAB     &trans        &kp SPACE                        &kp HOME     &kp END      &kp PG_UP   &kp PG_DN    &mo SYS
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 5: SYS
        // Bluetooth, ZMK Studio, RGB, backlight, media, firmware.
        // ═══════════════════════════════════════════════════════════════

        layer_sys {
            display-name = "SYS";
            bindings = <
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans                                                                    &trans      &studio_unlock  &none          &none          &none          &none          &none
&none      &none        &none        &none        &none        &none        &none                                                                     &none       &none           &none          &none          &none          &none          &none
&none      &none        &none        &none        &none        &none        &none        &none        &none        &none       &none      &none          &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI
&none      &none        &none        &none        &none        &none                                     &kp C_BRI_DN    &kp C_BRI_UP                                       &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
&none      &none        &none        &none        &none                             &none        &none       &none        &none       &none       &none                            &bl BL_INC  &bl BL_DEC  &bl BL_TOG  &kp LC(LG(Q)) &trans
            >;
        };

        // ═══════════════════════════════════════════════════════════════
        // LAYER 6: APP  (hold left inner-thumb Esc)
        // Ctrl+Alt+Gui+<key> for Hammerspoon / Karabiner / wm.
        // ═══════════════════════════════════════════════════════════════

        layer_app {
            display-name = "APP";
            bindings = <
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(N1))) &kp LC(LA(LG(N2))) &kp LC(LA(LG(N3))) &kp LC(LA(LG(N4))) &kp LC(LA(LG(N5))) &none                                                               &none                 &kp LC(LA(LG(N6))) &kp LC(LA(LG(N7))) &kp LC(LA(LG(N8))) &kp LC(LA(LG(N9))) &kp LC(LA(LG(N0))) &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))   &kp LC(LA(LG(Q)))  &kp LC(LA(LG(W)))  &kp LC(LA(LG(E)))  &kp LC(LA(LG(R)))  &kp LC(LA(LG(T)))  &none                                                               &none                 &kp LC(LA(LG(Y)))  &kp LC(LA(LG(U)))  &kp LC(LA(LG(I)))  &kp LC(LA(LG(O)))  &kp LC(LA(LG(P)))  &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))   &kp LC(LA(LG(A)))  &kp LC(LA(LG(S)))  &kp LC(LA(LG(D)))  &kp LC(LA(LG(F)))  &kp LC(LA(LG(G)))  &kp F13       &kp F14       &kp F15       &kp F16     &kp F17   &kp F18       &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI))) &kp LC(LA(LG(SQT)))
&kp LSHFT             &kp LC(LA(LG(Z)))  &kp LC(LA(LG(X)))  &kp LC(LA(LG(C)))  &kp LC(LA(LG(V)))  &kp LC(LA(LG(B)))                               &trans       &kp F19                                                  &kp LC(LA(LG(N))) &kp LC(LA(LG(M))) &kp LC(LA(LG(COMMA))) &kp LC(LA(LG(DOT))) &kp LC(LA(LG(FSLH))) &kp RSHFT
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(LBKT))) &kp LC(LA(LG(RBKT))) &kp LC(LA(LG(LPAR))) &kp LC(LA(LG(RPAR)))              &kp F20       &kp F21       &kp F22       &kp F23     &kp F24       &kp LC(LA(LG(SPACE)))           &kp LC(LA(LG(LEFT))) &kp LC(LA(LG(DOWN))) &kp LC(LA(LG(UP))) &kp LC(LA(LG(RIGHT))) &trans
            >;
        };
    };
};
