#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // HOME ROW MODS (Variant B tuning):
        // - quick-tap-ms = 0 disables "double tap always taps" behavior (helps HRM reliability)
        // - require-prior-idle-ms makes HRMs resolve to tap when typing quickly (reduces misfires)
        // See ZMK hold-tap docs for quick-tap-ms + require-prior-idle-ms. :contentReference[oaicite:1]{index=1}
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS";
            #binding-cells = <2>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;

            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // Existing "macro-to-Fkeys" kept where useful (mon/workspace),
        // but tile/float now send actual GlazeWM-friendly chords.

        // Toggle tiling direction (GlazeWM default sample uses alt+v). :contentReference[oaicite:2]{index=2}
        g_tile: g_tile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "G_TILE";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_tap &kp V>
              , <&macro_release &kp LALT>
              ;
        };

        // Toggle floating (GlazeWM default commonly uses alt+shift+space). :contentReference[oaicite:3]{index=3}
        g_float: g_float {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "G_FLOAT";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp SPACE>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };

        // Keep these as F-keys and bind them in GlazeWM config.
        g_mon_l: g_mon_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F15>;
            label = "G_MON_L";
        };

        g_mon_r: g_mon_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F16>;
            label = "G_MON_R";
        };

        // Re-purpose these in GlazeWM config as "prev/next active workspace on monitor".
        prof_wk: prof_wk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F17>;
            label = "PROF_WK";
        };

        prof_ps: prof_ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F18>;
            label = "PROF_PS";
        };

        // WM focus (Alt+H/J/K/L) — avoids Alt+Arrow conflicts with browser back/forward.
        gw_fl: gw_fl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_FOCUS_L";
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp H>, <&macro_release &kp LALT>;
        };
        gw_fd: gw_fd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_FOCUS_D";
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp J>, <&macro_release &kp LALT>;
        };
        gw_fu: gw_fu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_FOCUS_U";
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp K>, <&macro_release &kp LALT>;
        };
        gw_fr: gw_fr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_FOCUS_R";
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp L>, <&macro_release &kp LALT>;
        };

        // WM move window (Alt+Shift+H/J/K/L)
        gw_ml: gw_ml {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_MOVE_L";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp H>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };
        gw_md: gw_md {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_MOVE_D";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp J>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };
        gw_mu: gw_mu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_MOVE_U";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp K>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };
        gw_mr: gw_mr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_MOVE_R";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp L>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };

        // Close window (Alt+Shift+Q)
        gw_close: gw_close {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "GW_CLOSE";
            bindings
              = <&macro_press &kp LALT>
              , <&macro_press &kp LSHFT>
              , <&macro_tap &kp Q>
              , <&macro_release &kp LSHFT>
              , <&macro_release &kp LALT>
              ;
        };

        // Your existing AFN macro untouched
        afn: afn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp SPACE &kp RPAR &kp SPACE &kp LS(S) &kp P &kp A &kp C &kp E &kp SPACE &kp EQUAL &kp SPACE &kp GT &kp SPACE &kp LS(S) &kp P &kp A &kp C &kp E &kp SPACE &kp LBRC &kp SPACE &kp RBRC &kp SPACE &kp LS(L) &kp E &kp F &kp T>;
            label = "AFN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4            &kp N5  &none                                                      &mo 3        &kp N6  &kp N7       &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R             &kp T   &g_tile                                                    &g_float     &kp Y   &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC    &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &g_mon_l    &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &g_mon_r     &kp H   &hm RSHFT J  &hm RCTRL K  &hm RALT L  &hm RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V             &kp B                          &kp HOME      &kp PG_UP                          &kp N   &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
&kp GRAVE  &kp GRAVE   &kp CAPS    &kp LEFT     &kp RIGHT                 &lt 1 BSPC  &lt 1 DEL  &kp END       &kp PG_DN  &kp ENTER  &lt 2 SPACE          &kp UP       &kp DOWN     &kp LBKT    &kp RBKT       &mo 1
            >;
        };

        layer_nav {
            bindings = <
&kp F1  &kp F2            &kp F3             &kp F4                &kp F5                 &kp F6         &afn                                        &none   &kp F7    &kp F8      &kp F9      &kp F10     &kp F11            &kp F12
&trans  &none             &trans             &trans                &trans                 &trans         &none                                       &none   &trans    &kp UNDER   &kp PIPE    &kp PLUS    &kp DOUBLE_QUOTES  &trans
&trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND  &none   &trans  &trans      &trans  &trans  &none   &kp STAR  &kp EQUAL   &kp MINUS   &kp COLON   &kp SEMI           &trans
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp PERCENT                    &trans      &trans                  &kp EXCL  &kp AT      &kp HASH    &kp DLLR    &kp QMARK          &trans
&trans  &trans            &trans             &kp LA(N1)            &kp LA(N2)                            &trans  &trans  &trans      &trans  &none   &trans            &kp LA(N3)  &kp LA(N4)  &kp LA(N5)  &trans             &trans
            >;
        };

        layer_sym {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans    &trans          &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &kp HOME  &kp PG_DN       &kp PAGE_UP   &kp END    &trans

/* row with ESC A S D F G ... H J K L ; */
&trans  &gw_fl  &gw_fd  &gw_fu  &gw_fr  &trans  &none   &trans  &trans      &trans  &trans  &none   &none   &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans

/* row with LSHFT Z X C V B ... N M , . / */
&trans  &gw_ml  &gw_md  &gw_mu  &gw_mr  &gw_close               &trans      &trans                  &none   &kp LC(LS(TAB))  &kp LC(TAB)   &trans        &kp BSLH   &trans

&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans          &trans        &trans     &trans
            >;
        };

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                                        &trans                  &none  &none  &none  &none  &none  &none
&none  &prof_wk      &prof_ps      &none         &none         &none         &bootloader                                       &bootloader             &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none  &rgb_ug RGB_MEFS_CMD 5  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none                             &none      &none                                      &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &none  &none                          &none  &none  &none  &none  &none
            >;
        };
    };
};
