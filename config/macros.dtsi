/*
 * Text macros for the operator keys on SYM's bottom rows, and "0x" on NUM.
 *
 * What earns a slot: a multi-character operator that no editor completes for
 * you. `->`, `:=`, `**`, `!=` are single tokens to the language but two
 * keystrokes to you, and no LSP offers them from a prefix because there is no
 * prefix to offer from.
 *
 * What does not earn a slot: anything with autocomplete behind it. SQL
 * keywords used to live here - SELECT, FROM, PARTITION BY and forty more -
 * and they were removed. Every SQL surface in use (Databricks, DBeaver, the
 * VS Code SQL extensions) completes them from two characters with schema
 * awareness that firmware cannot have, so the macro saved two keystrokes and
 * cost a memorised position. The same argument retired the Python and
 * PySpark macros: Pylance finishes `display(`, `dbutils.` and `F.col(`, and
 * it knows which are in scope.
 *
 * PowerShell deliberately has no macros. `-` is unshifted on the base number
 * row, so `-match`, `-replace`, `-split` and `-join` are plain typing with no
 * layer hop, and every PowerShell symbol already sits on SYM: `$` `_` `@` `{}`
 * `()` `|` `~`. `$_` and `@{}` are a single SYM hold.
 *
 * Every macro is a plain tap sequence: no held modifiers spanning the macro,
 * no layer changes, nothing that can leave a modifier stuck.
 *
 * Timing is deliberately uniform. 5 ms is fast enough to feel instant and slow
 * enough to survive BLE HID on Windows; raise both numbers together if a host
 * ever drops characters.
 *
 * LENGTH CAP: keep sequences at or under 15 taps. Each tap is two HID reports,
 * and CONFIG_ZMK_BLE_KEYBOARD_REPORT_QUEUE_SIZE (40, set in adv360.conf) is
 * the ceiling. bin/validate_keymap.py enforces both halves of that arithmetic.
 * Nothing here comes close now that the bank is operators only - the longest
 * is two taps - but the cap stays because the check is what makes it safe to
 * add one later.
 */

#define TEXT_MACRO(nm, ...)                                                    \
    nm: nm {                                                                   \
        compatible = "zmk,behavior-macro";                                     \
        #binding-cells = <0>;                                                  \
        wait-ms = <5>;                                                         \
        tap-ms = <5>;                                                          \
        bindings = <__VA_ARGS__>;                                              \
    };

/ {
    macros {
        /* ---- Comparison ---------------------------------------------- */
        TEXT_MACRO(m_eq,       &kp EQUAL &kp EQUAL)
        TEXT_MACRO(m_ne,       &kp EXCL  &kp EQUAL)
        TEXT_MACRO(m_le,       &kp LT    &kp EQUAL)
        TEXT_MACRO(m_ge,       &kp GT    &kp EQUAL)
        TEXT_MACRO(m_sqlne,    &kp LT    &kp GT)

        /* ---- Assignment, arithmetic, scope ---------------------------- */
        TEXT_MACRO(m_walrus,   &kp COLON &kp EQUAL)
        TEXT_MACRO(m_arrow,    &kp MINUS &kp GT)
        TEXT_MACRO(m_pow,      &kp ASTRK &kp ASTRK)
        TEXT_MACRO(m_concat,   &kp PIPE  &kp PIPE)
        TEXT_MACRO(m_scope,    &kp COLON &kp COLON)
        TEXT_MACRO(m_dunder,   &kp UNDER &kp UNDER)

        /* ---- Literals ------------------------------------------------- */
        TEXT_MACRO(m_hex,      &kp N0 &kp X)
    };
};

#undef TEXT_MACRO
