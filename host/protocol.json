    "workspace": { "modifiers": [], "slots": 8 },
    "move_workspace": { "modifiers": ["shift"], "slots": 8 },
    "focus_direction": { "modifiers": ["control"], "keys": ["F13", "F14", "F15", "F16"] },
    "move_direction": { "modifiers": ["control", "shift"], "keys": ["F13", "F14", "F15", "F16"] },
    "window_state": { "modifiers": ["control"], "keys": ["F17", "F18", "F19", "F20"] },
    "window_command": { "modifiers": ["control", "shift"], "keys": ["F19", "F20"] },
    "developer_action": { "modifiers": ["alt"], "slots": 8 }
  },
  "directions": ["left", "down", "up", "right"],
