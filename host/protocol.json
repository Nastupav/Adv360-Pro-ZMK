    { "slot": 3, "signal": "Alt+F15", "gesture": "GLOBAL+W", "name": "browser" },
    { "slot": 4, "signal": "Alt+F16", "gesture": "GLOBAL+O", "name": "files" },
    { "slot": 5, "signal": "Alt+F17", "gesture": "GLOBAL+E", "name": "editor" },
    { "slot": 6, "signal": "Alt+F18", "gesture": "GLOBAL+P", "name": "project" },
    { "slot": 7, "signal": "Alt+F19", "gesture": "GLOBAL+U", "name": "git" },
    { "slot": 8, "signal": "Alt+F20", "gesture": "GLOBAL+I", "name": "ai" }
