{
  "title": "Advantage360 developer protocol",
  "rules": [
    {
      "description": "ADV360 normalize F14/F15 for Hammerspoon",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926, "is_keyboard": true }] }],
          "from": { "key_code": "f14", "modifiers": { "mandatory": ["left_control", "shift"] } },
          "to": [{ "key_code": "f14", "modifiers": ["left_command", "left_control", "left_shift"] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926, "is_keyboard": true }] }],
          "from": { "key_code": "f14", "modifiers": { "mandatory": ["left_control"] } },
          "to": [{ "key_code": "f14", "modifiers": ["left_command", "left_control"] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926, "is_keyboard": true }] }],
          "from": { "key_code": "f14", "modifiers": { "mandatory": ["shift"] } },
          "to": [{ "key_code": "f14", "modifiers": ["left_command", "left_shift"] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926, "is_keyboard": true }] }],
          "from": { "key_code": "f14", "modifiers": { "mandatory": ["left_option"] } },
          "to": [{ "key_code": "f14", "modifiers": ["left_command", "left_option"] }]
        },
