          "from": { "key_code": "f14" },
          "to": [{ "key_code": "f14", "modifiers": ["left_command"] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 7504, "product_id": 24926, "is_keyboard": true }] }],
          "from": { "key_code": "f15", "modifiers": { "mandatory": ["left_control", "shift"] } },
          "to": [{ "key_code": "f15", "modifiers": ["left_command", "left_control", "left_shift"] }]
        },
