/*
 * Kinesis Advantage360 Pro / ZMK keymap
 * Production ergonomic developer layout — macOS-primary, Linux/Windows secondary.
 *
 * Layer order:
 *   0 BASE
 *   1 NAV
 *   2 SYM
 *   3 NUM
 *   4 FUN
 *   5 SYS
 *   6 APP
 *
 * Compatibility notes (Kinesis adv360pro-zmk fork, V3.0 / current master):
 *   - Uses only widely-supported hold-tap properties:
 *       compatible, label, #binding-cells, flavor,
 *       tapping-term-ms, quick-tap-ms, bindings, hold-trigger-key-positions.
 *     The newer upstream-only properties `require-prior-idle-ms` and
 *     `hold-trigger-on-release` were intentionally dropped to guarantee a
 *     clean build on the Kinesis fork. If your fork pin includes them, they
 *     can be re-added under each hold-tap node — see the OPTIONAL block.
 *
 *   - macOS-first key bindings on NAV/FUN: clipboard / save / find / app-switch
 *     use Cmd (LG(...)). Bash/readline shortcuts (LC(A/E/U/K/W)) work in any
 *     terminal regardless of OS. Windows users should add a per-OS layer.
 *
 *   - Dangerous actions are protected:
 *       * &bootloader is on SYS row 2 only (requires SYS hold to reach).
 *       * &bt BT_CLR is exposed only via the SYS-only combo (BT_SEL 0 + BT_SEL 1).
 *
 * Matrix layout (per layer, 76 keys total):
 *   row1  6 + 1L-thumb-row + 1R-thumb-row + 6     = 14   pos  0..13
 *   row2  6 + 1 inner       + 1 inner        + 6  = 14   pos 14..27
 *   row3  6 + 3 thumb cluster + 3 thumb cluster + 6 = 18  pos 28..45
 *   row4  6 + 1L-thumb       + 1R-thumb       + 6 = 14   pos 46..59
 *   row5  5 + 3L-thumbs      + 3R-thumbs      + 5 = 16   pos 60..75
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4
#define SYS  5
#define APP  6

/ {
    behaviors {
        /*
         * Positional home-row mods.
         *
         * hml = left-hand home-row mod. Only triggers as a modifier when paired
         * with a key on the opposite hand. hmr is the mirror image. This nearly
         * eliminates accidental same-hand rolls such as "as", "sd", "jk", "kl".
         *
         * Order on each home row (pinky -> index): GUI, ALT, CTRL, SHIFT.
         * On macOS this puts Cmd on the pinky (heaviest mod on weakest finger),
         * which is intentional: positional triggers force cross-hand for any
         * Cmd+letter combo anyway, so the load is shifted to the other hand.
         *
         * OPTIONAL (newer ZMK only) — to reduce HRM misfires further, add:
         *     require-prior-idle-ms = <125>;
         *     hold-trigger-on-release;
         */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                8 9 10 11 12 13
                22 23 24 25 26 27
                37 38 39 40 41 42 43 44 45
                53 54 55 56 57 58 59
                68 69 70 71 72 73 74 75
            >;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0 1 2 3 4 5 6
                14 15 16 17 18 19 20
                28 29 30 31 32 33 34 35 36
                46 47 48 49 50 51 52
                60 61 62 63 64 65 66 67
            >;
        };

        /*
         * Balanced thumb layer-tap.
         * Hold for the layer; tap for the keycode. tapping-term-ms raised to 200
         * to reduce misfires on fast Space/Backspace/Enter rolls in shells/IDEs.
         */
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_LAYER_TAP";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /*
         * Clear ONLY the currently selected Bluetooth profile.
         * Gated to SYS layer; both BT_SEL 0 + BT_SEL 1 positions must be pressed
         * together. Will not trigger on any other layer.
         */
        combo_bt_clear {
            timeout-ms = <120>;
            key-positions = <1 2>;
            layers = <SYS>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =========================================================
        // LAYER 0: BASE
        // QWERTY with positional home-row mods. SYS reachable from three
        // places (top corners + far bottom-right) so it's always nearby
        // without conflicting with main typing.
        // =========================================================

        default_layer {
            display-name = "BASE";
            bindings = <
&kp EQUAL  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5     &mo SYS                                                                            &mo SYS           &kp N6    &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS
&kp TAB    &kp Q       &kp W       &kp E        &kp R        &kp T      &none                                                                              &none             &kp Y     &kp U        &kp I        &kp O        &kp P        &kp BSLH
&kp ESC    &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G      &kp LGUI       &kp LCTRL     &kp LALT        &kp RALT   &kp RCTRL  &kp RGUI      &kp H     &hmr RSHFT J &hmr RCTRL K &hmr RALT L  &hmr RGUI SEMI &kp SQT
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V        &kp B                                      &tlt APP ESC      &kp TAB                                               &kp N     &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
&kp GRAVE  &kp LBKT    &kp RBKT    &kp LPAR     &kp RPAR                 &tlt SYM BSPC   &tlt NUM DEL  &kp ESC         &kp TAB    &tlt FUN ENTER &tlt NAV SPACE                    &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &mo SYS
            >;
        };

        // =========================================================
        // LAYER 1: NAV  (hold right-thumb Space)
        // macOS-tuned. Arrows on J/K/L/; (NOT H/J/K/L) — index stays on home,
        // matching Kinesis ergonomics where reaching to H is an inward stretch.
        //   J = LEFT   K = DOWN   L = UP   ; = RIGHT
        //   H = HOME   ' = ENTER
        // Left hand: mac clipboard/undo (Cmd) + bash readline (Ctrl).
        // =========================================================

        layer_nav {
            display-name = "NAV";
            bindings = <
&kp ESC    &kp LA(LEFT)       &kp LA(RIGHT)       &kp LG(LBKT)       &kp LG(RBKT)        &kp PSCRN        &none                                                                         &none       &kp LC(LS(TAB)) &kp LC(TAB)    &kp LG(TAB)      &kp LG(LS(TAB)) &kp PG_UP      &kp PG_DN
&kp TAB    &kp LG(Z)          &kp LG(LS(Z))       &kp LG(X)          &kp LG(C)           &kp LG(V)        &none                                                                         &none       &kp HOME        &kp PG_DN      &kp PG_UP        &kp END         &kp DEL        &kp BSPC
&kp ESC    &kp LC(A)          &kp LC(E)           &kp LC(U)          &kp LC(K)           &kp LC(W)        &kp LGUI       &kp LCTRL      &kp LALT        &kp RALT     &kp RCTRL    &kp RGUI       &kp HOME  &kp LEFT      &kp DOWN     &kp UP        &kp RIGHT      &kp ENTER
&kp LSHFT  &kp LG(S)          &kp LG(F)           &kp LG(R)          &kp LG(D)           &kp LG(L)                                        &trans           &trans                                              &kp LA(LEFT) &kp LA(RIGHT) &kp LA(LS(LEFT)) &kp LA(LS(RIGHT)) &kp LA(BSPC) &kp RSHFT
&kp ESC    &kp TAB            &kp LG(Z)           &kp LG(LS(Z))      &kp LG(F)                           &kp BSPC       &kp DEL       &kp LSHFT       &kp LCTRL     &kp ENTER      &trans                            &kp HOME  &kp END       &kp PG_UP    &kp PG_DN     &trans
            >;
        };

        // =========================================================
        // LAYER 2: SYM  (hold left-thumb Backspace)
        // Opening delimiters on left, closing delimiters on right.
        // =========================================================

        layer_sym {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &none                                                                          &none       &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR   &kp TILDE
&kp TAB    &kp TILDE &kp GRAVE &kp BSLH  &kp FSLH  &kp PIPE   &none                                                                          &none       &kp AMPS   &kp STAR  &kp MINUS &kp UNDER  &kp COLON  &kp SEMI
&kp ESC    &kp LPAR  &kp LBKT  &kp LBRC  &kp LT    &kp EQUAL  &kp EXCL      &kp AT        &kp HASH       &kp DLLR   &kp PRCNT  &kp CARET    &kp PLUS &kp GT    &kp RBRC  &kp RBKT   &kp RPAR   &kp DQT
&kp LSHFT  &kp SQT   &kp DQT   &kp COMMA &kp DOT   &kp QMARK                               &trans          &trans                                          &kp AMPS  &kp STAR  &kp MINUS &kp UNDER  &kp FSLH   &kp RSHFT
&kp GRAVE  &kp SQT   &kp DQT   &kp LPAR  &kp RPAR                         &trans       &kp DEL       &kp ESC        &kp TAB    &kp ENTER  &kp SPACE                         &kp UNDER &kp MINUS &kp EQUAL &kp COLON  &kp SEMI
            >;
        };

        // =========================================================
        // LAYER 3: NUM  (hold left-thumb Delete)
        // Right-hand numpad; left side keeps navigation + readline.
        // =========================================================

        layer_num {
            display-name = "NUM";
            bindings = <
&kp ESC    &kp F1    &kp F2    &kp F3       &kp F4       &kp F5     &none                                                                          &none      &kp F6    &kp F7    &kp F8    &kp F9     &kp F10   &kp F11
&kp TAB    &kp HOME  &kp PG_DN &kp PG_UP    &kp END      &kp BSPC   &none                                                                          &none      &kp N7    &kp N8    &kp N9    &kp MINUS  &kp PLUS  &kp BSPC
&kp ESC    &kp LC(A) &kp LC(E) &kp LC(U)    &kp LC(K)    &kp LC(W)  &kp LGUI      &kp LCTRL     &kp LALT       &kp RALT  &kp RCTRL &kp RGUI     &kp N4  &kp N5    &kp N6    &kp STAR   &kp FSLH  &kp ENTER
&kp LSHFT  &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT    &kp DEL                                  &trans          &trans                                         &kp N1    &kp N2    &kp N3    &kp DOT    &kp COMMA  &kp RSHFT
&kp ESC    &kp TAB   &kp BSPC  &kp DEL      &kp EQUAL                           &trans       &trans       &kp ESC        &kp N0    &kp ENTER  &kp SPACE                        &kp N0    &kp DOT   &kp PLUS  &kp MINUS  &kp ENTER
            >;
        };

        // =========================================================
        // LAYER 4: FUN  (hold right-thumb Enter)
        // F-keys, IDE/browser commands, macOS screenshots, lock.
        //   row 5 left: ` Cmd+Shift+3 Cmd+Shift+4 Cmd+Shift+5 Cmd+Ctrl+Q (lock)
        // Windows alts (set on host or via per-OS layer):
        //   screenshot: LG(LS(S))   lock: LG(L)
        // =========================================================

        layer_fun {
            display-name = "FUN";
            bindings = <
&kp ESC    &kp F1       &kp F2       &kp F3          &kp F4          &kp F5       &none                                                                          &none        &kp F6          &kp F7        &kp F8       &kp F9       &kp F10      &kp F11
&kp TAB    &kp F13      &kp F14      &kp F15         &kp F16         &kp F17      &none                                                                          &none        &kp F18         &kp F19       &kp F20      &kp F21      &kp F22      &kp F12
&kp ESC    &kp LG(S)    &kp LG(F)    &kp LG(LS(P))   &kp LG(P)       &kp LG(W)    &kp LGUI      &kp LCTRL     &kp LALT       &kp RALT    &kp RCTRL  &kp RGUI      &kp LG(LBKT) &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(RBKT)  &kp F11   &kp LC(LG(Q))
&kp LSHFT  &kp LG(Z)    &kp LG(X)    &kp LG(C)       &kp LG(V)       &kp LG(LS(Z))                            &trans          &trans                                            &kp C_PREV  &kp C_PP      &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP &kp RSHFT
&kp GRAVE  &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LC(LG(Q))                         &kp BSPC      &kp DEL       &kp ESC        &kp TAB     &trans       &kp SPACE                         &kp HOME    &kp END      &kp PG_UP    &kp PG_DN    &mo SYS
            >;
        };

        // =========================================================
        // LAYER 5: SYS
        // Bluetooth profiles, RGB, backlight, media, firmware.
        // BT_CLR is intentionally NOT bound directly; only via the
        // combo_bt_clear (BT_SEL 0 + BT_SEL 1) gated to this layer.
        // RGB controls realigned to the right main 6 keys (under Y/U/I/O/P/\).
        // =========================================================

        layer_sys {
            display-name = "SYS";
            bindings = <
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans                                                                        &trans       &none           &none           &none           &none           &none           &none
&none      &none        &none        &none        &none        &none        &bootloader                                                                   &bootloader  &none           &none           &none           &none           &none           &none
&none      &none        &none        &none        &none        &none        &none        &none        &none        &none       &none      &none           &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI
&none      &none        &none        &none        &none        &none                                      &kp C_BRI_DN     &kp C_BRI_UP                                     &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE
&none      &none        &none        &none        &none                              &none        &none        &none        &none       &none       &none                            &bl BL_INC  &bl BL_DEC   &bl BL_TOG   &kp LC(LG(Q)) &trans
            >;
        };

        // =========================================================
        // LAYER 6: APP  (hold left thumb-cluster Esc)
        // Host-defined app/window-manager shortcuts, Ctrl+Alt+Gui+<key>.
        // Bind these in Hammerspoon / Karabiner / GlazeWM / AutoHotkey, etc.
        // =========================================================

        layer_app {
            display-name = "APP";
            bindings = <
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(N1))) &kp LC(LA(LG(N2))) &kp LC(LA(LG(N3))) &kp LC(LA(LG(N4))) &kp LC(LA(LG(N5))) &none                                                               &none                 &kp LC(LA(LG(N6))) &kp LC(LA(LG(N7))) &kp LC(LA(LG(N8))) &kp LC(LA(LG(N9))) &kp LC(LA(LG(N0))) &kp LC(LA(LG(MINUS)))
&kp LC(LA(LG(TAB)))   &kp LC(LA(LG(Q)))  &kp LC(LA(LG(W)))  &kp LC(LA(LG(E)))  &kp LC(LA(LG(R)))  &kp LC(LA(LG(T)))  &none                                                               &none                 &kp LC(LA(LG(Y)))  &kp LC(LA(LG(U)))  &kp LC(LA(LG(I)))  &kp LC(LA(LG(O)))  &kp LC(LA(LG(P)))  &kp LC(LA(LG(BSLH)))
&kp LC(LA(LG(ESC)))   &kp LC(LA(LG(A)))  &kp LC(LA(LG(S)))  &kp LC(LA(LG(D)))  &kp LC(LA(LG(F)))  &kp LC(LA(LG(G)))  &kp F13       &kp F14       &kp F15       &kp F16     &kp F17   &kp F18       &kp LC(LA(LG(H))) &kp LC(LA(LG(J))) &kp LC(LA(LG(K))) &kp LC(LA(LG(L))) &kp LC(LA(LG(SEMI))) &kp LC(LA(LG(SQT)))
&kp LSHFT             &kp LC(LA(LG(Z)))  &kp LC(LA(LG(X)))  &kp LC(LA(LG(C)))  &kp LC(LA(LG(V)))  &kp LC(LA(LG(B)))                               &trans       &kp F19                                                  &kp LC(LA(LG(N))) &kp LC(LA(LG(M))) &kp LC(LA(LG(COMMA))) &kp LC(LA(LG(DOT))) &kp LC(LA(LG(FSLH))) &kp RSHFT
&kp LC(LA(LG(GRAVE))) &kp LC(LA(LG(LBKT))) &kp LC(LA(LG(RBKT))) &kp LC(LA(LG(LPAR))) &kp LC(LA(LG(RPAR)))              &kp F20       &kp F21       &kp F22       &kp F23     &kp F24       &kp SPACE                       &kp LC(LA(LG(LEFT))) &kp LC(LA(LG(DOWN))) &kp LC(LA(LG(UP))) &kp LC(LA(LG(RIGHT))) &trans
            >;
        };
    };
};
